# Web3Forms access key — get yours free at https://web3forms.com
PUBLIC_WEB3FORMS_KEY=

# Sanity CMS — project ID and dataset are public (safe to expose in client bundles).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Sanity write-access token — server-side only, never exposed to the browser.
# Generate at https://www.sanity.io/manage → project → API → Tokens
SANITY_API_TOKEN=
