{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // @sanity/astro/module enables the `sanity:client` virtual import in .astro files.
    "types": ["@sanity/astro/module"]
  },
  "include": [
    ".astro/types.d.ts",
    "**/*",
    // Explicitly include TypeGen output so the compiler always picks up generated types.
    "sanity.types.ts"
  ],
  "exclude": ["dist"]
}
