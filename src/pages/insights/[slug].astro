---
// [slug].astro — individual blog post detail page.
// Slugs come from Sanity blogPost collection; content is fetched per slug at build time.
import Layout from "../../layouts/Layout.astro";
import { getBlogPostSlugs, getBlogPostBySlug } from "../../lib/api/blog";
import { urlFor } from "../../lib/utils/sanityImage";
import { buildBreadcrumbSchema } from "../../lib/content/schema";
import { SITE_DOMAIN } from "../../lib/content/site";

export async function getStaticPaths() {
  const slugs = await getBlogPostSlugs();
  return (slugs ?? []).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug);

if (!post) throw new Error(`Blog post "${slug}" not found in Sanity. Publish the document in Studio.`);

const coverUrl = post.coverImage
  ? urlFor(post.coverImage as any).width(1200).height(630).fit("crop").format("webp").url()
  : null;

const lqip = post.coverImage?.asset?.metadata?.lqip ?? null;

const date = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-AU", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;

const postUrl = `https://${SITE_DOMAIN}/insights/${slug}`;

const breadcrumbJsonLd = buildBreadcrumbSchema([
  { name: "Home", url: `https://${SITE_DOMAIN}` },
  { name: "Insights", url: `https://${SITE_DOMAIN}/insights` },
  { name: post.title ?? "", url: postUrl },
]);

// Portable text → HTML (handles the most common block types and marks)
function renderBlocks(blocks: any[]): string {
  if (!blocks?.length) return "";
  return blocks
    .map((block) => {
      if (block._type !== "block") return "";
      const html = (block.children ?? [])
        .map((span: any) => {
          let text = (span.text ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
          if (span.marks?.includes("strong")) text = `<strong>${text}</strong>`;
          if (span.marks?.includes("em")) text = `<em>${text}</em>`;
          if (span.marks?.includes("underline")) text = `<u>${text}</u>`;
          return text;
        })
        .join("");
      switch (block.style) {
        case "h2": return `<h2 class="post-h2">${html}</h2>`;
        case "h3": return `<h3 class="post-h3">${html}</h3>`;
        case "h4": return `<h4 class="post-h4">${html}</h4>`;
        case "blockquote": return `<blockquote class="post-blockquote">${html}</blockquote>`;
        default: return html ? `<p class="post-p">${html}</p>` : "";
      }
    })
    .join("\n");
}

const bodyHtml = renderBlocks(post.body ?? []);
---

<Layout
  title={post.seoTitle ?? post.title ?? undefined}
  description={post.seoDescription ?? post.excerpt ?? undefined}
  navBg="#fff"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <article class="post-page">
    <!-- Hero -->
    <header class="post-hero">
      <div class="post-hero-inner">
        <nav class="post-breadcrumb" aria-label="Breadcrumb">
          <a href="/insights" class="breadcrumb-link">Insights</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span class="breadcrumb-current" aria-current="page">{post.title}</span>
        </nav>

        <div class="post-meta">
          {post.category && <span class="post-category">{post.category}</span>}
          {date && <time class="post-date" datetime={post.publishedAt}>{date}</time>}
          {post.author && <span class="post-author">By {post.author}</span>}
        </div>

        <h1 class="post-title">{post.title}</h1>

        {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
      </div>
    </header>

    <!-- Cover image -->
    {coverUrl && (
      <div class="post-cover-wrap">
        <img
          src={coverUrl}
          alt={post.coverImage?.alt ?? post.title}
          class="post-cover"
          loading="eager"
          decoding="async"
          width="1200"
          height="630"
          style={lqip ? `background-image: url('${lqip}'); background-size: cover;` : undefined}
        />
      </div>
    )}

    <!-- Body -->
    <div class="post-body-wrap">
      <div class="post-body" set:html={bodyHtml} />
    </div>

    <!-- Back link -->
    <div class="post-footer-wrap">
      <a href="/insights" class="back-link">
        <span aria-hidden="true">&#8592;</span>
        Back to Insights
      </a>
    </div>
  </article>
</Layout>

<style>
  /* ── Page shell ──────────────────────────────────────────── */
  .post-page {
    background: #fff;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .post-hero {
    background: var(--color-bg-hero);
    padding: 4rem 2rem 3rem;
  }
  .post-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    flex-wrap: wrap;
  }
  .breadcrumb-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--weight-medium);
    transition: color 0.15s;
  }
  .breadcrumb-link:hover {
    color: var(--color-accent);
  }
  .breadcrumb-link:focus-visible {
    outline: 2px solid var(--color-accent);
    border-radius: 2px;
  }
  .breadcrumb-sep {
    color: oklch(65% 0.02 240);
  }
  .breadcrumb-current {
    color: oklch(50% 0.025 240);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 28ch;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  .post-category {
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-primary);
    background: rgba(0, 50, 125, 0.07);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }
  .post-date {
    font-size: var(--text-sm);
    color: oklch(50% 0.025 240);
  }
  .post-author {
    font-size: var(--text-sm);
    color: oklch(50% 0.025 240);
  }
  .post-title {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: var(--weight-bold);
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
    margin: 0;
  }
  .post-excerpt {
    font-size: var(--text-lg);
    color: oklch(45% 0.02 240);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 60ch;
  }

  /* ── Cover image ─────────────────────────────────────────── */
  .post-cover-wrap {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .post-cover {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    display: block;
    object-fit: cover;
    max-height: 520px;
    box-shadow: 0 8px 40px rgba(0, 50, 125, 0.12);
    margin-top: -1.5rem;
  }

  /* ── Body ────────────────────────────────────────────────── */
  .post-body-wrap {
    max-width: 800px;
    margin: 3.5rem auto 0;
    padding: 0 2rem;
  }
  .post-body :global(.post-p) {
    font-size: var(--text-base);
    line-height: 1.8;
    color: oklch(35% 0.02 240);
    margin: 0 0 1.5rem;
  }
  .post-body :global(.post-h2) {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: var(--weight-bold);
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
    margin: 2.5rem 0 0.875rem;
  }
  .post-body :global(.post-h3) {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: var(--weight-semibold);
    color: var(--color-text-heading);
    line-height: var(--leading-tight);
    margin: 2rem 0 0.75rem;
  }
  .post-body :global(.post-h4) {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-heading);
    margin: 1.5rem 0 0.5rem;
  }
  .post-body :global(.post-blockquote) {
    border-left: 3px solid var(--color-primary);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background: rgba(0, 50, 125, 0.04);
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
    color: oklch(40% 0.025 240);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  /* ── Back link ───────────────────────────────────────────── */
  .post-footer-wrap {
    max-width: 800px;
    margin: 4rem auto 5rem;
    padding: 0 2rem;
    border-top: 1px solid rgba(0, 50, 125, 0.08);
    padding-top: 2rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.2s cubic-bezier(0.22, 1, 0.36, 1), color 0.15s;
  }
  .back-link:hover {
    gap: 0.75rem;
    color: var(--color-accent);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--color-accent);
    border-radius: 2px;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .post-hero {
      padding: 3rem 1.25rem 2rem;
    }
    .post-cover-wrap {
      padding: 0 1.25rem;
    }
    .post-body-wrap {
      padding: 0 1.25rem;
    }
    .post-footer-wrap {
      padding: 2rem 1.25rem 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-hero-inner,
    .post-cover-wrap,
    .post-body-wrap {
      opacity: 0;
    }
  }
</style>

<script>
  import { animate } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      (animate as any)(
        ".post-hero-inner",
        { opacity: [0, 1], y: [24, 0] },
        { duration: 0.55, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".post-cover-wrap",
        { opacity: [0, 1], y: [16, 0] },
        { duration: 0.5, easing: [0.22, 1, 0.36, 1], delay: 0.1 },
      );
      (animate as any)(
        ".post-body-wrap",
        { opacity: [0, 1] },
        { duration: 0.45, easing: "ease-out", delay: 0.2 },
      );
    }
  });
</script>
