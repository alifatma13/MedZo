---
// about.astro — About Us page: fetches all content from Sanity and composes sections.
import Layout from "../layouts/Layout.astro";
import AboutHeroSection from "../components/sections/AboutHeroSection.astro";
import FounderSection from "../components/sections/FounderSection.astro";
import MissionSection from "../components/sections/MissionSection.astro";
import ValuesSection from "../components/sections/ValuesSection.astro";
import TeamSection from "../components/sections/TeamSection.astro";
import CredentialsSection from "../components/sections/CredentialsSection.astro";
import { getAboutPage } from "../lib/api/aboutPage";
import { getTeamMembers } from "../lib/api/team";

const [data, teamMembers] = await Promise.all([
  getAboutPage(),
  getTeamMembers(),
]);

if (!data) throw new Error("About page not found in Sanity. Publish the About Page document in Studio.");

// founderBio arrives as a single text field; split on double-newlines for paragraph rendering
const founderBio = (data.founderBio ?? "").split("\n\n").filter(Boolean);

// heroParagraphs: split heroBody on double-newlines for AboutHeroSection
const heroParagraphs = (data.heroBody ?? "").split("\n\n").filter(Boolean);
---

<Layout title={data.seoTitle ?? undefined} description={data.seoDescription ?? undefined}>
  <AboutHeroSection
    title=""
    heading={data.heroHeading}
    paragraphs={heroParagraphs}
  />
  <FounderSection
    founder={{
      sectionHeading: data.founderSectionHeading,
      intro: data.founderIntro,
      name: data.founderName,
      role: data.founderRole,
      bio: founderBio,
      photo: data.founderPhoto ?? null,
    }}
  />
  <MissionSection heading={data.missionHeading} body={data.missionBody} />
  <ValuesSection heading={data.valuesHeading} items={data.valuesItems ?? []} />

  <!-- Team + CTA share one navy canvas with blobs spanning both -->
  <div class="navy-band">
    <div class="nb-blob nb-blob-1" aria-hidden="true"></div>
    <div class="nb-blob nb-blob-2" aria-hidden="true"></div>
    <div class="nb-overlay" aria-hidden="true"></div>
    <TeamSection
      heading={data.teamSectionHeading}
      body={data.teamSectionBody}
      members={teamMembers ?? []}
    />
    <CredentialsSection
      ctaHeading={data.ctaHeading ?? undefined}
      ctaBody={data.ctaBody}
      ctaButtonLabel={data.ctaButtonLabel}
      ctaButtonHref="/contact"
    />
  </div>
</Layout>

<style>
  .navy-band {
    background: var(--color-primary);
    position: relative;
    overflow: hidden;
  }
  .nb-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background: radial-gradient(ellipse at 50% 40%, #fff 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .nb-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }
  .nb-blob-1 {
    width: 700px;
    height: 700px;
    top: -140px;
    right: -120px;
    background: radial-gradient(circle, rgba(0, 193, 253, 0.18) 0%, transparent 60%);
  }
  .nb-blob-2 {
    width: 500px;
    height: 500px;
    bottom: -100px;
    left: -80px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 65%);
  }
</style>
