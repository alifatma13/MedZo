---
// ServiceCard.astro — icon + title + description card used in the ServicesSection grid.
import { icons } from "../../lib/utils/icons";
import { ui } from "../../lib/content/ui";
import type { ServiceCard } from "../../types/ServiceCard";
interface Props extends ServiceCard {}
const { iconName, title, description, gentuNote, href } = Astro.props;
---

<div class="card">
  <div class="card-head">
    <div class="icon-wrap" aria-hidden="true">
      <Fragment set:html={icons[iconName] ?? ""} />
    </div>
    <h3 class="card-title">{title}</h3>
  </div>
  <p class="card-desc">{description}</p>
  {gentuNote && (
    <div class="gentu-note">
      <span class="gentu-badge">{ui.gentuBadgeLabel}</span>
      <span class="gentu-text">{gentuNote}</span>
    </div>
  )}
  {href && (
    <a href={href} class="card-link" aria-label={`Explore ${title}`}>
      <span>{ui.exploreServiceLabel}</span>
      <Fragment set:html={icons["arrow-right"] ?? ""} />
    </a>
  )}
</div>

<style>
  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--color-accent-text);
    box-shadow:
      0 20px 40px rgba(0, 193, 253, 0.12),
      0 8px 16px rgba(0, 50, 125, 0.08);
  }
  .card:hover::after {
    transform: translateX(100%);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    padding: 8px;
    background: var(--gradient-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #fff;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .icon-wrap {
    transform: scale(1.12);
  }
  .icon-wrap svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .card-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    margin: 0;
    letter-spacing: normal;
  }
  .card-desc {
    font-size: var(--text-base);
    color: var(--color-text-body);
    margin: 0;
    line-height: var(--leading-normal);
    flex: 1;
  }
  .gentu-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .gentu-badge {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    background: rgba(0, 193, 253, 0.1);
    border: 1px solid rgba(0, 193, 253, 0.25);
    border-radius: 0.25rem;
    padding: 0.15rem 0.4rem;
    line-height: 1.4;
  }
  .gentu-text {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: var(--leading-normal);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    transition: gap 0.2s cubic-bezier(0.22, 1, 0.36, 1), color 0.15s;
  }
  .card-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card-link:hover {
    color: var(--color-accent-text);
    gap: 0.6rem;
  }
  .card-link:hover svg {
    transform: translateX(3px);
  }
  .card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card::after, .icon-wrap, .card-link, .card-link svg { transition: none; }
  }
</style>
