---
// CredentialsSection.astro — full-width CTA band at the bottom of the About page.
import Button from "../ui/Button.astro";
interface Props {
	ctaBody: string;
	ctaButtonLabel: string;
	ctaButtonHref: string;
}
const { ctaBody, ctaButtonLabel, ctaButtonHref } = Astro.props;
---

<section class="cta-band">
	<div class="cta-inner">
		<p class="cta-body">{ctaBody}</p>
		<Button label={ctaButtonLabel} href={ctaButtonHref} variant="accent" />
	</div>
</section>

<style>
	.cta-band {
		background: transparent;
		padding: 6rem clamp(1.5rem, 8%, 6rem);
		text-align: center;
		position: relative;
		z-index: 1;
	}
	.cta-inner {
		position: relative;
		z-index: 1;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}
	.cta-body {
		font-size: clamp(1.125rem, 2vw, var(--text-2xl));
		color: oklch(98% 0.006 220);
		line-height: 1.5;
		margin: 0;
		max-width: 90ch;
		font-weight: var(--weight-medium);
	}
	@media (max-width: 640px) {
		.cta-band { padding: 4rem 1.5rem; }
		.cta-inner { gap: 1.25rem; }
	}
	@media (prefers-reduced-motion: no-preference) {
		.cta-body,
		.btn {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		inView(".cta-band", () => {
			(animate as any)(
				".cta-band .cta-body",
				{ opacity: [0, 1], y: [24, 0] },
				{ duration: 0.6, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".cta-band .btn",
				{ opacity: [0, 1], y: [16, 0] },
				{ duration: 0.5, delay: 0.2, easing: [0.22, 1, 0.36, 1] },
			);
		});
	});
</script>
