---
// ServiceFeatureGrid.astro — bento-style feature grid for service detail pages.
import { icons } from "../../lib/utils/icons";
import type { ServiceFeature } from "../../types/services";
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  features: ServiceFeature[];
}
const { eyebrow, heading, intro, features } = Astro.props;
---

<section class="svc-features">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="section-heading">{heading}</h2>
      <p class="section-intro">{intro}</p>
    </div>

    <div class="feature-grid">
      {features.map((feature, i) => (
        <div class={`feature-card${i === 0 ? " feature-card--hero" : ""}`} data-num={String(i + 1).padStart(2, "0")}>
          <div class="feature-head">
            <div class="feature-icon" aria-hidden="true">
              <Fragment set:html={icons[feature.iconName] ?? ""} />
            </div>
            <h3 class="feature-title">{feature.title}</h3>
          </div>
          <p class="feature-body">{feature.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .svc-features {
    background: linear-gradient(155deg, #f4f7ff 0%, #edf1ff 40%, #f8faff 100%);
    padding: 6rem clamp(1.5rem, 8%, 6rem);
    position: relative;
    overflow: hidden;
  }
  .svc-features::before {
    content: "";
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 193, 253, 0.07) 0%, transparent 70%);
    top: -200px;
    right: -150px;
    pointer-events: none;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    position: relative;
    z-index: 1;
  }

  /* ── Section header ──────────────────────────────────── */
  .section-header {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 700px;
  }
  .section-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .section-heading {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1.1;
    color: var(--color-primary);
  }
  .section-intro {
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ── Bento grid ──────────────────────────────────────── */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  /* ── Base card ───────────────────────────────────────── */
  .feature-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 0.75rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 2px 8px rgba(0, 50, 125, 0.05);
  }

  /* ── Icon + title row ────────────────────────────────── */
  .feature-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .feature-card::before {
    content: attr(data-num);
    position: absolute;
    font-size: 6rem;
    font-weight: var(--weight-extrabold);
    color: rgba(0, 50, 125, 0.04);
    bottom: -0.5rem;
    right: 1rem;
    line-height: 1;
    pointer-events: none;
    font-family: var(--font-nav);
    letter-spacing: -0.05em;
  }
  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 24px rgba(0, 50, 125, 0.08),
      0 2px 8px rgba(0, 193, 253, 0.06);
  }

  /* ── Hero card (first) ───────────────────────────────── */
  .feature-card--hero {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    gap: 2.5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, color-mix(in srgb, var(--color-accent) 25%, var(--color-primary)) 100%);
    border: none;
    padding: 2.5rem 3rem;
    box-shadow: 0 4px 16px rgba(0, 50, 125, 0.15);
  }
  .feature-card--hero::before {
    color: rgba(255, 255, 255, 0.06);
    font-size: 8rem;
    bottom: -1rem;
    right: 2rem;
  }
  .feature-card--hero .feature-head {
    align-items: center;
    flex-shrink: 0;
  }
  .feature-card--hero .feature-icon {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 40px;
    height: 40px;
    padding: 9px;
  }
  .feature-card--hero .feature-title {
    color: #fff;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
  }
  .feature-card--hero .feature-body {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-base);
    flex: 1;
    align-self: center;
  }
  .feature-card--hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 50, 125, 0.22);
  }

  /* ── Icon ────────────────────────────────────────────── */
  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 0.625rem;
    padding: 8px;
    background: var(--gradient-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .feature-icon svg { width: 100%; height: 100%; }

  /* ── Text ────────────────────────────────────────────── */
  .feature-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    margin: 0;
    letter-spacing: var(--tracking-normal);
    line-height: 1.3;
  }
  .feature-body {
    font-size: var(--text-base);
    color: var(--color-text-body);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────── */
  /* Tablet: collapse to 2-column — 3-col at ≤1024px gives ~209px inner text width */
  @media (max-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .feature-card--hero { flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 2rem; }
    .feature-card--hero .feature-head { width: 100%; align-items: center; }
  }
  @media (max-width: 768px) {
    .svc-features { padding: 4rem clamp(1.5rem, 5%, 2.5rem); }
    .container { gap: 2.5rem; }
  }
  @media (max-width: 600px) {
    .svc-features { padding: 4rem clamp(1.5rem, 5%, 2rem); }
    .container { max-width: none; gap: 2.5rem; }
    .feature-grid { grid-template-columns: 1fr; }
    .feature-card--hero { padding: 1.75rem; }
  }

  /* ── Orphan card fix ─────────────────────────────────── */
  /* When the last non-hero card lands alone in its row (2-col grid),
     span it full width so it doesn't sit isolated at col 1. */
  @media (min-width: 601px) {
    .feature-card:not(.feature-card--hero):last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-card, .feature-icon { transition: none; }
  }
</style>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .section-eyebrow,
    .section-heading,
    .section-intro,
    .feature-card {
      opacity: 0;
    }
  }
</style>

<script>
  // Scroll-triggered staggered reveal for the eyebrow, heading, intro, and feature cards.
  import { animate, inView, stagger } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      inView(".svc-features", () => {
        (animate as any)(
          ".svc-features .section-eyebrow",
          { opacity: [0, 1], y: [12, 0] },
          { duration: 0.45, easing: [0.22, 1, 0.36, 1] },
        );
        (animate as any)(
          ".svc-features .section-heading",
          { opacity: [0, 1], y: [18, 0] },
          { duration: 0.55, delay: 0.08, easing: [0.22, 1, 0.36, 1] },
        );
        (animate as any)(
          ".svc-features .section-intro",
          { opacity: [0, 1], y: [14, 0] },
          { duration: 0.5, delay: 0.16, easing: [0.22, 1, 0.36, 1] },
        );
        (animate as any)(
          ".svc-features .feature-card",
          { opacity: [0, 1], y: [32, 0] },
          { duration: 0.55, delay: stagger(0.08, { startDelay: 0.22 }), easing: [0.22, 1, 0.36, 1] },
        );
      });
    }
  });
</script>
