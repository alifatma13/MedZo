---
// ValuesSection.astro — company values as an editorial numbered list: no cards, no icon grid.
import type { AboutValue } from "../../types/AboutContent";
interface Props {
	heading: string;
	items: AboutValue[];
}
const { heading, items } = Astro.props;
---

<section class="values">
	<div class="container">
		<h2 class="section-heading">{heading}</h2>
		<ul class="list" role="list">
			{
				items.map((item, i) => (
					<li class="item">
						<span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
						<h3 class="title">{item.title}</h3>
						<p class="body-text">{item.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.values {
		background: oklch(99% 0.005 220);
		padding: 5rem clamp(1.5rem, 8%, 6rem) 6rem;
	}
	.container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}
	.section-heading {
		font-size: clamp(1.75rem, 3.5vw, 3rem);
		font-weight: var(--weight-extrabold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin: 0;
	}

	/* ── List ── */
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid oklch(88% 0.01 220);
	}
	.item {
		display: grid;
		grid-template-columns: 3rem 1fr 1.75fr;
		column-gap: 3rem;
		align-items: start;
		padding: 2.25rem 0;
		border-bottom: 1px solid oklch(88% 0.01 220);
	}

	/* ── Numeral ── */
	.num {
		font-size: var(--text-sm);
		font-family: var(--font-nav);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
		padding-top: 0.2rem;
	}

	/* ── Value title ── */
	.title {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		line-height: var(--leading-tight);
		margin: 0;
	}

	/* ── Value body ── */
	.body-text {
		font-size: var(--text-base);
		color: var(--color-text-body);
		line-height: var(--leading-loose);
		margin: 0;
	}

	/* ── Responsive ── */
	/* Padding relief for tablet range (covers 801–960px gap) */
	@media (max-width: 960px) {
		.values {
			padding: 4rem clamp(1.5rem, 6%, 4rem) 5rem;
		}
	}
	/* Grid collapse: 3-col → num + text at 800px and below */
	@media (max-width: 800px) {
		.item {
			grid-template-columns: 3rem 1fr;
			grid-template-rows: auto auto;
			column-gap: 1.5rem;
		}
		.num {
			grid-row: 1;
			grid-column: 1;
		}
		.title {
			grid-row: 1;
			grid-column: 2;
		}
		.body-text {
			grid-row: 2;
			grid-column: 2;
			margin-top: 0.5rem;
		}
	}
	@media (max-width: 560px) {
		.values {
			padding: 3.5rem 1.5rem 4.5rem;
		}
		.item {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 2rem 0;
		}
		.num {
			padding-top: 0;
		}
	}

	/* ── No-flash: initial states for animated elements ── */
	@media (prefers-reduced-motion: no-preference) {
		.section-heading,
		.item {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		inView(".values .section-heading", () => {
			(animate as any)(
				".values .section-heading",
				{ opacity: [0, 1], y: [16, 0] },
				{ duration: 0.5, easing: [0.22, 1, 0.36, 1] },
			);
		});

		inView(".values .list", () => {
			(animate as any)(
				".values .item",
				{ opacity: [0, 1], y: [20, 0] },
				{ duration: 0.5, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
			);
		});
	});
</script>
