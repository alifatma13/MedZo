---
// WhyChooseUs.astro — metrics bar + radial layout: items orbit a circular photo hub.
import { Image } from "astro:assets";
import WhyItem from "../ui/WhyItem.astro";
import type { WhyItem as WhyItemType } from "../../types/WhyItem";
import type { Metric } from "../../types/Metric";
interface Props {
	heading: string;
	items: WhyItemType[];
	imageAlt?: string;
	whyImageUrl?: string;
	metrics: Metric[];
}
const { heading, items, metrics, whyImageUrl, imageAlt } = Astro.props;

const halfLen = Math.ceil(items.length / 2);
const leftItems = items.slice(0, halfLen);
const rightItems = items.slice(halfLen);
---

<section class="why">
	<div class="metrics-bar">
		<div class="metrics-inner">
			{
				metrics.map((m) => (
					<div
						class="metric-item"
						role="img"
						aria-label={`${m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}${m.suffix} ${m.label}`}
					>
						<p class="metric-value" aria-hidden="true">
							<span class="count" data-target={m.value} data-suffix={m.suffix}>
								{m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}{m.suffix}
							</span>
						</p>
						<p class="metric-label" aria-hidden="true">{m.label}</p>
					</div>
				))
			}
		</div>
	</div>

	<div class="radial-section" id="why-medzo">
		<h2 class="section-title">{heading}</h2>
		<div class="radial-grid">
			<ul class="radial-col radial-left" role="list">
				{leftItems.map((item) => (
					<li class="radial-item">
						<WhyItem {...item} />
					</li>
				))}
			</ul>

			<div class="radial-hub" aria-hidden="true">
				<div class="hub-ring">
					<div class="hub-inner">
						{whyImageUrl && (
							<Image
								src={whyImageUrl}
								alt={imageAlt ?? ""}
								class="hub-img"
								width={400}
								height={400}
								loading="lazy"
							/>
						)}
					</div>
				</div>
			</div>

			<ul class="radial-col radial-right" role="list">
				{rightItems.map((item) => (
					<li class="radial-item">
						<WhyItem {...item} />
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.why {
		background: oklch(97% 0.01 220);
		padding: 0 0 4rem;
		position: relative;
	}

	/* ── Metrics bar ── */
	.metrics-bar {
		background: var(--color-primary);
		padding: 3.5rem clamp(1.5rem, 8%, 6rem);
	}
	.metrics-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: center;
	}
	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	.metric-item:not(:last-child) {
		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}
	.metric-value {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: var(--weight-extrabold);
		color: #fff;
		line-height: 1;
		margin: 0;
		letter-spacing: var(--tracking-tight);
		text-shadow:
			0 0 24px rgba(0, 193, 253, 0.55),
			0 0 60px rgba(0, 193, 253, 0.25);
	}
	.metric-label {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
		line-height: var(--leading-normal);
	}

	/* ── Radial section ── */
	.radial-section {
		max-width: 1280px;
		margin: 0 auto;
		padding: 4rem clamp(1.5rem, 8%, 6rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
	}
	.section-title {
		font-size: clamp(1.5rem, 3vw, var(--text-4xl));
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		text-align: center;
		max-width: 28ch;
	}

	/* ── Three-column radial grid ── */
	.radial-grid {
		display: grid;
		grid-template-columns: 1fr 210px 1fr;
		gap: 2.5rem;
		align-items: center;
		width: 100%;
	}
	.radial-col {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.radial-item {
		padding: 0.875rem 0;
		border-bottom: 1px solid oklch(90% 0.02 220);
	}
	.radial-item:first-child { padding-top: 0; }
	.radial-item:last-child { border-bottom: none; padding-bottom: 0; }

	/* Truncate descriptions to 2 lines */
	.radial-col :global(.item-desc) {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Left column faces the hub: icon on the right edge, text right-aligned */
	.radial-left :global(.why-item) { flex-direction: row-reverse; }
	.radial-left :global(.content)  { align-items: flex-end; }
	.radial-left :global(.item-title),
	.radial-left :global(.item-desc) { text-align: right; }

	/* ── Hub ── */
	.radial-hub {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hub-ring {
		width: 200px;
		height: 200px;
		border-radius: 50%;
		background: var(--gradient-brand);
		padding: 5px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 8px 32px oklch(40% 0.15 230 / 0.2);
		flex-shrink: 0;
	}
	.hub-inner {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
	}
	.hub-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ── Responsive ── */
	@media (max-width: 1024px) {
		.radial-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.radial-hub { display: none; }
		/* Un-reverse left items when the hub is gone */
		.radial-left :global(.why-item) { flex-direction: row; }
		.radial-left :global(.content)  { align-items: flex-start; }
		.radial-left :global(.item-title),
		.radial-left :global(.item-desc) { text-align: left; }
		/* Un-clamp descriptions on single-column layout */
		.radial-col :global(.item-desc) {
			display: block;
			-webkit-line-clamp: unset;
			overflow: visible;
		}
	}

	@media (max-width: 900px) {
		.why { padding-bottom: 3.5rem; }
		.radial-section { padding-top: 3rem; }
	}

	@media (max-width: 768px) {
		.why { padding: 0 0 3rem; }
		.metrics-bar { padding: 2.5rem clamp(1.5rem, 5%, 3rem); }
		.radial-section { padding-top: 2.5rem; gap: 2rem; }
		.metrics-inner { grid-template-columns: 1fr; }
		.metric-item:not(:last-child) {
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.why { padding: 0 0 3.5rem; }
		.metrics-bar { padding: 2rem 1.5rem; }
		.radial-section { padding-top: 2rem; }
	}

	@media (prefers-reduced-motion: no-preference) {
		.section-title { clip-path: inset(0 0 100% 0); }
		.hub-ring,
		.radial-item { opacity: 0; }
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		// ── Count-up animation for metrics ──
		inView(".why .metrics-bar", () => {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			document.querySelectorAll<HTMLElement>(".why .count").forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const suffix = el.dataset.suffix ?? "";
				const isLarge = target >= 1000;
				const format = (v: number) =>
					isLarge ? Math.round(v).toLocaleString("en-AU") : Math.round(v).toString();
				if (reduced) { el.textContent = format(target) + suffix; return; }
				el.textContent = format(0) + suffix;
				(animate as any)(0, target, {
					duration: isLarge ? 2.2 : 1.4,
					easing: [0.22, 1, 0.36, 1],
					onUpdate: (v: number) => { el.textContent = format(v) + suffix; },
				});
			});
		});

		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".why .radial-section", () => {
				const hub = document.querySelector<HTMLElement>(".why .hub-ring");
				const title = document.querySelector<HTMLElement>(".why .section-title");
				const items = document.querySelectorAll<HTMLElement>(".why .radial-item");
				if (hub)
					(animate as any)(
						hub,
						{ opacity: [0, 1], scale: [0.75, 1] },
						{ duration: 0.65, easing: [0.22, 1, 0.36, 1] },
					);
				if (title)
					(animate as any)(
						title,
						{ clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"], y: [20, 0] },
						{ duration: 0.65, delay: 0.1, easing: [0.22, 1, 0.36, 1] },
					);
				if (items.length)
					(animate as any)(
						items,
						{ opacity: [0, 1], y: [12, 0] },
						{ duration: 0.4, delay: stagger(0.07, { startDelay: 0.2 }), easing: [0.22, 1, 0.36, 1] },
					);
			});
		}
	});
</script>
