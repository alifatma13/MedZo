---
// WhyChooseUs.astro — metrics bar + two-column section with a photo and a list of reasons to choose MedZo.
import { Image } from "astro:assets";
import whyImage from "../../res/why_us.png";
import WhyItem from "../ui/WhyItem.astro";
import type { WhyItem as WhyItemType } from "../../types/WhyItem";
import type { Metric } from "../../types/Metric";
interface Props {
	heading: string;
	items: WhyItemType[];
	imageAlt: string;
	metrics: Metric[];
}
const { heading, items, imageAlt, metrics } = Astro.props;
---

<section class="why">
	<div class="metrics-bar">
		<div class="metrics-inner">
			{
				metrics.map((m) => (
					<div
						class="metric-item"
						role="img"
						aria-label={`${m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}${m.suffix} ${m.label}`}
					>
						<p class="metric-value" aria-hidden="true">
							<span class="count" data-target={m.value} data-suffix={m.suffix}>
								{m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}{m.suffix}
							</span>
						</p>
						<p class="metric-label" aria-hidden="true">{m.label}</p>
					</div>
				))
			}
		</div>
	</div>
	<div class="container" id="why-medzo">
		<div class="image-col">
			<Image
				src={whyImage}
				alt={imageAlt}
				class="section-img"
				widths={[480, 640, 900, 1200, 1600]}
				sizes="(max-width: 768px) 100vw, 50vw"
				format="webp"
				quality={80}
				loading="lazy"
			/>
		</div>
		<div class="content-col">
			<h2 class="section-title">{heading}</h2>
			<ul class="items-list">
				{
					items.map((item) => (
						<li>
							<WhyItem {...item} />
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.why {
		background: #f0f6ff;
		padding: 0 0 6rem;
		position: relative;
	}

	/* ── Metrics bar ── */
	.metrics-bar {
		background: var(--color-primary);
		padding: 3.5rem clamp(1.5rem, 8%, 6rem);
	}
	.metrics-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: center;
	}
	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	.metric-item:not(:last-child) {
		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}
	.metric-value {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: var(--weight-extrabold);
		color: #fff;
		line-height: 1;
		margin: 0;
		letter-spacing: var(--tracking-tight);
		text-shadow:
			0 0 24px rgba(0, 193, 253, 0.55),
			0 0 60px rgba(0, 193, 253, 0.25);
	}
	.metric-label {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
		line-height: var(--leading-normal);
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 6rem clamp(1.5rem, 8%, 6rem) 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
		position: relative;
		z-index: 1;
	}

	.image-col {
		border-radius: 1rem;
		overflow: hidden;
		box-shadow:
			0 20px 25px -5px rgba(0, 0, 0, 0.1),
			0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}
	.section-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		aspect-ratio: 1407/768;
	}
	.content-col {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.section-title {
		font-size: var(--text-4xl);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}
	.items-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	/* Tablet: container top padding relief before full mobile collapse */
	@media (max-width: 900px) {
		.why {
			padding-bottom: 5rem;
		}
		.container {
			padding-top: 4rem;
		}
	}

	@media (max-width: 768px) {
		.why {
			padding: 0 0 4rem;
		}
		.metrics-bar {
			padding: 2.5rem clamp(1.5rem, 5%, 3rem);
		}
		.container {
			grid-template-columns: 1fr;
			padding-top: 3.5rem;
			gap: 2.5rem;
		}
		.image-col {
			display: none;
		}
		.metrics-inner {
			grid-template-columns: 1fr;
		}
		.metric-item:not(:last-child) {
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.5rem;
		}
	}
	@media (max-width: 480px) {
		.why {
			padding: 0 0 3.5rem;
		}
		.metrics-bar {
			padding: 2rem 1.5rem;
		}
		.container {
			padding-top: 2.5rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.image-col,
		.items-list li {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		// ── Count-up animation for metrics ──
		inView(".why .metrics-bar", () => {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			document.querySelectorAll<HTMLElement>(".why .count").forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const suffix = el.dataset.suffix ?? "";
				const isLarge = target >= 1000;
				const format = (v: number) =>
					isLarge ? Math.round(v).toLocaleString("en-AU") : Math.round(v).toString();
				if (reduced) { el.textContent = format(target) + suffix; return; }
				el.textContent = format(0) + suffix;
				(animate as any)(0, target, {
					duration: isLarge ? 2.2 : 1.4,
					easing: [0.22, 1, 0.36, 1],
					onUpdate: (v: number) => { el.textContent = format(v) + suffix; },
				});
			});
		});

		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".why", () => {
				const imageCol = document.querySelector(".why .image-col");
				const title = document.querySelector(".why .section-title");
				const items = document.querySelectorAll(".why .items-list li");
				if (imageCol)
					(animate as any)(
						imageCol,
						{ opacity: [0, 1], x: [-32, 0] },
						{ duration: 0.6, easing: [0.22, 1, 0.36, 1] },
					);
				if (title)
					(animate as any)(
						title,
						{ clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"], y: [20, 0] },
						{ duration: 0.65, delay: 0.1, easing: [0.22, 1, 0.36, 1] },
					);
				if (items.length)
					(animate as any)(
						items,
						{ opacity: [0, 1], x: [20, 0] },
						{ duration: 0.45, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
					);
			});
		}
	});
</script>
