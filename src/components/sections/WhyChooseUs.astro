---
// WhyChooseUs.astro — metrics bar + radial layout: items orbit a circular photo hub.
import { Image } from "astro:assets";
import WhyItem from "../ui/WhyItem.astro";
import type { WhyItem as WhyItemType } from "../../types/content";
import type { Metric } from "../../types/content";
interface Props {
	heading: string;
	items: WhyItemType[];
	imageAlt?: string;
	whyImageUrl?: string;
	metrics: Metric[];
}
const { heading, items, metrics, whyImageUrl, imageAlt } = Astro.props;

const halfLen = Math.ceil(items.length / 2);
const leftItems = items.slice(0, halfLen);
const rightItems = items.slice(halfLen);
---

<section class="why">
	<div class="metrics-bar">
		<div class="metrics-inner">
			{
				metrics.map((m) => (
					<div
						class="metric-item"
						role="img"
						aria-label={`${m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}${m.suffix} ${m.label}`}
					>
						<p class="metric-value" aria-hidden="true">
							<span class="count" data-target={m.value} data-suffix={m.suffix}>
								{m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}{m.suffix}
							</span>
						</p>
						<p class="metric-label" aria-hidden="true">{m.label}</p>
					</div>
				))
			}
		</div>
	</div>

	<div class="radial-section" id="why-medzo">
		<h2 class="section-title">{heading}</h2>
		<div class="radial-grid">
			<ul class="radial-col radial-left" role="list">
				{leftItems.map((item) => (
					<li class="radial-item">
						<WhyItem {...item} />
					</li>
				))}
			</ul>

			<div class="radial-hub" aria-hidden="true">
				<div class="hub-ring">
					<div class="hub-inner">
						{whyImageUrl && (
							<Image
								src={whyImageUrl}
								alt={imageAlt ?? ""}
								class="hub-img"
								width={400}
								height={400}
								loading="lazy"
							/>
						)}
					</div>
				</div>
			</div>

			<ul class="radial-col radial-right" role="list">
				{rightItems.map((item) => (
					<li class="radial-item">
						<WhyItem {...item} />
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.why {
		background: oklch(99% 0.005 220);
		padding: 0 0 4rem;
		position: relative;
	}

	/* ── Metrics bar ── */
	.metrics-bar {
		background: var(--color-primary);
		padding: 3.5rem clamp(1.5rem, 8%, 6rem);
	}
	.metrics-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		text-align: center;
	}
	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	.metric-item:not(:last-child) {
		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}
	.metric-value {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: var(--weight-extrabold);
		color: oklch(99% 0.005 220);
		line-height: 1;
		margin: 0;
		letter-spacing: var(--tracking-tight);
		text-shadow:
			0 0 24px rgba(0, 193, 253, 0.55),
			0 0 60px rgba(0, 193, 253, 0.25);
	}
	.metric-label {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
		line-height: var(--leading-normal);
		letter-spacing: 0.02em;
	}

	/* ── Radial section ── */
	.radial-section {
		max-width: 1280px;
		margin: 0 auto;
		padding: 5rem clamp(1.5rem, 8%, 6rem) 5.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
	}
	.section-title {
		font-size: var(--text-4xl);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin: 0 0 5rem;
		text-align: center;
	}

	/* ── Radial grid ── */
	.radial-grid {
		display: grid;
		grid-template-columns: 1fr 340px 1fr;
		gap: 2.5rem;
		align-items: stretch;
		width: 100%;
		position: relative;
	}

	/* Faint radial glow anchored at the hub center */
	.radial-grid::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 380px;
		height: 380px;
		border-radius: 50%;
		background: radial-gradient(circle, oklch(91% 0.04 220 / 0.35) 0%, transparent 52%);
		pointer-events: none;
		z-index: 0;
	}

	.radial-col {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		z-index: 1;
	}
	.radial-item {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1.25rem 0;
		position: relative;
	}

	/* Left column: icon on right edge, text right-aligned toward hub */
	.radial-left :global(.why-item) { flex-direction: row-reverse; }
	.radial-left :global(.content)  { align-items: flex-end; }
	.radial-left :global(.item-title),
	.radial-left :global(.item-desc) { text-align: right; }

	/* ── Hub ── */
	.radial-hub {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 1;
	}
	.radial-hub::before {
		content: '';
		position: absolute;
		width: 400px;
		height: 480px;
		border-radius: 50%;
		background: oklch(88% 0.008 220 / 0.55);
		filter: blur(28px);
		pointer-events: none;
		z-index: 0;
	}
	.hub-ring {
		width: 320px;
		height: 400px;
		border-radius: 50%;
		background: transparent;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 16px 48px oklch(35% 0.12 230 / 0.2);
		flex-shrink: 0;
		position: relative;
		z-index: 1;
	}
	.hub-inner {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		background: var(--color-primary);
	}
	.hub-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ── Responsive ── */
	@media (max-width: 1024px) {
		.radial-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.radial-grid::before { display: none; }
		.radial-hub { display: none; }
		.radial-item {
			padding: 0.875rem 0;
			border-bottom: 1px solid oklch(90% 0.02 220);
		}
		.radial-item:first-child { padding-top: 0; }
		.radial-item:last-child { border-bottom: none; padding-bottom: 0; }
		/* Un-reverse left items when the hub is gone */
		.radial-left :global(.why-item) { flex-direction: row; }
		.radial-left :global(.content)  { align-items: flex-start; }
		.radial-left :global(.item-title),
		.radial-left :global(.item-desc) { text-align: left; }
	}

	@media (max-width: 900px) {
		.why { padding-bottom: 3.5rem; }
		.radial-section { padding-top: 3rem; }
	}

	@media (max-width: 768px) {
		.why { padding: 0 0 3rem; }
		.metrics-bar { padding: 2.5rem clamp(1.5rem, 5%, 3rem); }
		.radial-section { padding-top: 2.5rem; gap: 2rem; }
		.metrics-inner { grid-template-columns: repeat(2, 1fr); }
		.metric-item:nth-child(2n) { border-right: none; }
		.metric-item:nth-child(-n+2) {
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.why { padding: 0 0 3.5rem; }
		.metrics-bar { padding: 2rem 1.5rem; }
		.radial-section { padding-top: 2rem; }
		.metrics-inner { grid-template-columns: 1fr; }
		.metric-item:not(:last-child) {
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.section-title,
		.hub-ring,
		.radial-item { opacity: 0; }
	}
</style>

<script>
	// Count-up for metrics, radial hub/item entrance animations, and inView observer cleanup between navigations.
	import { animate, inView, stagger } from "motion";

	// Module-level vars so each navigation cancels the previous inView observers
	let stopMetrics: (() => void) | null = null;
	let stopRadial: (() => void) | null = null;

	document.addEventListener("astro:page-load", () => {
		// Clean up observers from previous navigation
		if (stopMetrics) { stopMetrics(); stopMetrics = null; }
		if (stopRadial) { stopRadial(); stopRadial = null; }

		// Clear inline styles Motion left on the previous visit so CSS opacity: 0 takes effect
		document.querySelectorAll<HTMLElement>(".why .hub-ring, .why .section-title, .why .radial-item")
			.forEach((el) => { el.style.opacity = ""; el.style.transform = ""; });

		// ── Count-up animation for metrics ──
		stopMetrics = inView(".why .metrics-bar", () => {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			document.querySelectorAll<HTMLElement>(".why .count").forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const suffix = el.dataset.suffix ?? "";
				// Numbers >= 1000 use locale-formatted strings (e.g. "1,000")
				const isLarge = target >= 1000;
				const format = (v: number) =>
					isLarge ? Math.round(v).toLocaleString("en-AU") : Math.round(v).toString();
				// Show final value immediately when motion is reduced
				if (reduced) { el.textContent = format(target) + suffix; return; }
				el.textContent = format(0) + suffix;
				(animate as any)(0, target, {
					duration: isLarge ? 2.2 : 1.4,
					easing: [0.22, 1, 0.36, 1],
					onUpdate: (v: number) => { el.textContent = format(v) + suffix; },
				});
			});
		});

		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			// Animate the hub image and orbiting items when the radial layout scrolls into view
			stopRadial = inView(".why .radial-section", () => {
				const hub = document.querySelector<HTMLElement>(".why .hub-ring");
				const title = document.querySelector<HTMLElement>(".why .section-title");
				const items = document.querySelectorAll<HTMLElement>(".why .radial-item");
				if (hub)
					(animate as any)(
						hub,
						{ opacity: [0, 1], scale: [0.75, 1] },
						{ duration: 0.65, easing: [0.22, 1, 0.36, 1] },
					);
				if (title)
					(animate as any)(
						title,
						{ opacity: [0, 1], y: [20, 0] },
						{ duration: 0.65, delay: 0.1, easing: [0.22, 1, 0.36, 1] },
					);
				if (items.length)
					(animate as any)(
						items,
						{ opacity: [0, 1], y: [12, 0] },
						{ duration: 0.4, delay: stagger(0.07, { startDelay: 0.2 }), easing: [0.22, 1, 0.36, 1] },
					);
			});
		}
	});
</script>
