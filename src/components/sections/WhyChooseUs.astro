---
// WhyChooseUs.astro — metrics bar + two-column section with a photo and a list of reasons to choose MedZo.
// whyImageUrl is a Sanity CDN URL computed in the page via urlFor(data.whyImage).
import { Image } from "astro:assets";
import WhyItem from "../ui/WhyItem.astro";
import { icons } from "../../lib/utils/icons";
import type { WhyItem as WhyItemType } from "../../types/WhyItem";
import type { Metric } from "../../types/Metric";
interface Props {
	heading: string;
	items: WhyItemType[];
	imageAlt: string;
	whyImageUrl: string;
	metrics: Metric[];
}
const { heading, items, imageAlt, whyImageUrl, metrics } = Astro.props;

// Derive badge value from the appointments metric so it stays in sync with metrics data
const apptMetric = metrics.find((m) => m.label.toLowerCase().includes("appointment"));
const badgeValue = apptMetric
	? `${apptMetric.value >= 1000 ? (apptMetric.value / 1000).toLocaleString("en-AU") + "k" : apptMetric.value}${apptMetric.suffix}`
	: null;
const badgeLabel = apptMetric?.label ?? null;
---

<section class="why">
	<div class="metrics-bar">
		<div class="metrics-inner">
			{
				metrics.map((m) => (
					<div
						class="metric-item"
						role="img"
						aria-label={`${m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}${m.suffix} ${m.label}`}
					>
						<p class="metric-value" aria-hidden="true">
							<span class="count" data-target={m.value} data-suffix={m.suffix}>
								{m.value >= 1000 ? m.value.toLocaleString("en-AU") : m.value}{m.suffix}
							</span>
						</p>
						<p class="metric-label" aria-hidden="true">{m.label}</p>
					</div>
				))
			}
		</div>
	</div>
	<div class="container" id="why-medzo">
		<div class="image-col">
			<!-- Dot-grid decoration (top-left) -->
			<div class="img-dots" aria-hidden="true"></div>
			<!-- Gradient offset block that peeks behind the photo (bottom-right) -->
			<div class="img-offset" aria-hidden="true"></div>
			<!-- Photo card with overflow-hidden for the badge -->
			<div class="img-card">
				<Image
					src={whyImageUrl}
					alt={imageAlt}
					class="section-img"
					width={960}
					height={640}
					loading="lazy"
				/>
				{badgeValue && badgeLabel && (
					<div class="img-badge" aria-hidden="true">
						<span class="badge-icon">
							<Fragment set:html={icons["check-circle"]} />
						</span>
						<div class="badge-body">
							<strong class="badge-value">{badgeValue}</strong>
							<span class="badge-label">{badgeLabel}</span>
						</div>
					</div>
				)}
			</div>
		</div>
		<div class="content-col">
			<h2 class="section-title">{heading}</h2>
			<ul class="items-list">
				{
					items.map((item) => (
						<li>
							<WhyItem {...item} />
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.why {
		background: #f0f6ff;
		padding: 0 0 6rem;
		position: relative;
	}

	/* ── Metrics bar ── */
	.metrics-bar {
		background: var(--color-primary);
		padding: 3.5rem clamp(1.5rem, 8%, 6rem);
	}
	.metrics-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: center;
	}
	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	.metric-item:not(:last-child) {
		border-right: 1px solid rgba(255, 255, 255, 0.12);
	}
	.metric-value {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: var(--weight-extrabold);
		color: #fff;
		line-height: 1;
		margin: 0;
		letter-spacing: var(--tracking-tight);
		text-shadow:
			0 0 24px rgba(0, 193, 253, 0.55),
			0 0 60px rgba(0, 193, 253, 0.25);
	}
	.metric-label {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
		line-height: var(--leading-normal);
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 6rem clamp(1.5rem, 8%, 6rem) 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
		position: relative;
		z-index: 1;
	}

	/* ── Modern image treatment ── */
	.image-col {
		position: relative;
		/* Extra room so the dot grid and offset block can bleed outside the photo */
		padding: 0.75rem 0.75rem 0.75rem 0;
	}

	/* Repeating dot-grid — top-left corner decoration */
	.img-dots {
		position: absolute;
		top: 0;
		left: -0.5rem;
		width: 150px;
		height: 150px;
		background-image: radial-gradient(circle, rgba(0, 193, 253, 0.4) 1.5px, transparent 1.5px);
		background-size: 18px 18px;
		pointer-events: none;
		z-index: 0;
	}

	/* Brand-gradient block offset behind and to the bottom-right of the photo */
	.img-offset {
		position: absolute;
		bottom: 0;
		right: 0;
		width: calc(100% - 0.5rem);
		height: calc(100% - 0.75rem);
		background: var(--gradient-brand);
		border-radius: 1.5rem;
		opacity: 0.1;
		z-index: 0;
	}

	/* The actual photo card */
	.img-card {
		position: relative;
		z-index: 1;
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow:
			0 32px 64px rgba(0, 50, 125, 0.16),
			0 8px 24px rgba(0, 193, 253, 0.1),
			0 0 0 1px rgba(0, 193, 253, 0.1);
	}

	.section-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		aspect-ratio: 1407/768;
	}

	/* Frosted-glass badge floating over the photo */
	.img-badge {
		position: absolute;
		bottom: 1.25rem;
		left: 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(0, 193, 253, 0.22);
		border-radius: 0.875rem;
		padding: 0.625rem 1rem;
		box-shadow:
			0 8px 20px rgba(0, 50, 125, 0.12),
			0 2px 6px rgba(0, 0, 0, 0.06);
	}
	.badge-icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--color-accent);
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}
	.badge-icon :global(svg) {
		width: 100%;
		height: 100%;
	}
	.badge-body {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.badge-value {
		font-size: 0.875rem;
		font-weight: var(--weight-extrabold);
		color: var(--color-primary);
		line-height: 1.1;
	}
	.badge-label {
		font-size: 0.65rem;
		font-weight: var(--weight-semibold);
		color: var(--color-text-body);
		line-height: 1.2;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.content-col {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.section-title {
		font-size: clamp(1.5rem, 5vw, var(--text-4xl));
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}
	.items-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	/* Tablet: container top padding relief before full mobile collapse */
	@media (max-width: 900px) {
		.why {
			padding-bottom: 5rem;
		}
		.container {
			padding-top: 4rem;
		}
	}

	@media (max-width: 768px) {
		.why {
			padding: 0 0 4rem;
		}
		.metrics-bar {
			padding: 2.5rem clamp(1.5rem, 5%, 3rem);
		}
		.container {
			grid-template-columns: 1fr;
			padding-top: 3.5rem;
			gap: 2.5rem;
		}
		.image-col {
			display: none;
		}
		.metrics-inner {
			grid-template-columns: 1fr;
		}
		.metric-item:not(:last-child) {
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.5rem;
		}
	}
	@media (max-width: 480px) {
		.why {
			padding: 0 0 3.5rem;
		}
		.metrics-bar {
			padding: 2rem 1.5rem;
		}
		.container {
			padding-top: 2.5rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.img-card,
		.items-list li {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		// ── Count-up animation for metrics ──
		inView(".why .metrics-bar", () => {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			document.querySelectorAll<HTMLElement>(".why .count").forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const suffix = el.dataset.suffix ?? "";
				const isLarge = target >= 1000;
				const format = (v: number) =>
					isLarge ? Math.round(v).toLocaleString("en-AU") : Math.round(v).toString();
				if (reduced) { el.textContent = format(target) + suffix; return; }
				el.textContent = format(0) + suffix;
				(animate as any)(0, target, {
					duration: isLarge ? 2.2 : 1.4,
					easing: [0.22, 1, 0.36, 1],
					onUpdate: (v: number) => { el.textContent = format(v) + suffix; },
				});
			});
		});

		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".why", () => {
				const imgCard = document.querySelector(".why .img-card");
				const title = document.querySelector(".why .section-title");
				const items = document.querySelectorAll(".why .items-list li");
				if (imgCard)
					(animate as any)(
						imgCard,
						{ opacity: [0, 1], x: [-32, 0] },
						{ duration: 0.6, easing: [0.22, 1, 0.36, 1] },
					);
				if (title)
					(animate as any)(
						title,
						{ clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"], y: [20, 0] },
						{ duration: 0.65, delay: 0.1, easing: [0.22, 1, 0.36, 1] },
					);
				if (items.length)
					(animate as any)(
						items,
						{ opacity: [0, 1], x: [20, 0] },
						{ duration: 0.45, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
					);
			});
		}
	});
</script>
