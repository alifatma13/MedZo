---
// ServicesSection.astro — services rendered as a featured band + numbered editorial list.
import type { ServiceCard } from "../../types/ServiceCard";
import type { SectionHeading } from "../../types/SectionHeading";
import { icons } from "../../lib/utils/icons";
interface Props {
	heading: SectionHeading;
	services: ServiceCard[];
}
const { heading, services } = Astro.props;
const [featured, ...rest] = services;
---

<section class="services" id="services">
	<div class="container">
		<header class="section-header">
			<div class="title-col">
				{heading.eyebrow && <span class="eyebrow">{heading.eyebrow}</span>}
				<h2 class="section-title">{heading.title}</h2>
			</div>
			<p class="section-body">{heading.body}</p>
		</header>

		<div class="feature-band">
			<div class="feature-content">
				<h3 class="feature-title">{featured.title}</h3>
				<p class="feature-desc">{featured.description}</p>
				{featured.href && (
					<a href={featured.href} class="feature-link">
						Learn more <span aria-hidden="true">→</span>
					</a>
				)}
			</div>
			<div class="feature-icon" aria-hidden="true">
				<Fragment set:html={icons[featured.iconName]} />
			</div>
		</div>

		<ul class="service-list" role="list">
			{rest.map((service, i) => (
				<li class="service-item">
					<span class="item-num" aria-hidden="true">{(i + 2).toString().padStart(2, "0")}</span>
					<div class="item-body">
						<div class="item-header">
							<span class="item-icon" aria-hidden="true">
								<Fragment set:html={icons[service.iconName]} />
							</span>
							<h3 class="item-title">{service.title}</h3>
						</div>
						<p class="item-desc">{service.description}</p>
						{service.href && (
							<a href={service.href} class="item-link">
								Learn more <span aria-hidden="true">→</span>
							</a>
						)}
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.services {
		background: var(--color-bg-hero);
		padding: 6rem 2rem 7rem;
	}
	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		flex-direction: column;
		gap: 4rem;
	}

	/* ── Section header ── */
	.section-header {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: end;
	}
	.title-col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.eyebrow {
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.section-title {
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		line-height: 1.1;
	}
	.section-body {
		font-size: var(--text-base);
		color: var(--color-text-body);
		margin: 0;
		line-height: var(--leading-relaxed);
		max-width: 28rem;
		align-self: end;
	}

	/* ── Featured service band ── */
	.feature-band {
		background: rgba(0, 193, 253, 0.08);
		border-top: 3px solid var(--color-accent);
		border-radius: 1.25rem;
		padding: 3rem 3.5rem;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 3rem;
		align-items: center;
	}
	.feature-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.feature-title {
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		font-weight: var(--weight-bold);
		color: var(--color-text-heading);
		margin: 0;
		line-height: 1.2;
	}
	.feature-desc {
		font-size: var(--text-base);
		color: var(--color-text-body);
		margin: 0;
		line-height: var(--leading-relaxed);
		max-width: 52ch;
	}
	.feature-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
		text-decoration: none;
		width: fit-content;
		transition: gap 0.15s ease;
	}
	.feature-link:hover {
		gap: 0.65rem;
	}
	.feature-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
		outline-offset: 2px;
	}
	.feature-icon {
		width: 5rem;
		height: 5rem;
		background: rgba(0, 193, 253, 0.12);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-accent);
		flex-shrink: 0;
	}
	.feature-icon :global(svg) {
		width: 2.25rem;
		height: 2.25rem;
	}

	/* ── Numbered service list ── */
	.service-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.service-item {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1.5rem;
		padding: 2.5rem 3rem 2.5rem 0;
		border-top: 1px solid var(--color-border);
		align-items: start;
	}
	.service-item:nth-child(even) {
		padding-left: 3rem;
		padding-right: 0;
		border-left: 1px solid var(--color-border);
	}
	.item-num {
		font-size: 2.5rem;
		font-weight: var(--weight-bold);
		color: oklch(89% 0.016 220);
		line-height: 1;
		padding-top: 0.1rem;
	}
	.item-body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.item-header {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}
	.item-icon {
		width: 1.125rem;
		height: 1.125rem;
		color: var(--color-accent);
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}
	.item-icon :global(svg) {
		width: 100%;
		height: 100%;
	}
	.item-title {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		color: var(--color-text-heading);
		margin: 0;
		line-height: var(--leading-tight);
	}
	.item-desc {
		font-size: var(--text-sm);
		color: var(--color-text-body);
		line-height: var(--leading-relaxed);
		margin: 0;
	}
	.item-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
		text-decoration: none;
		width: fit-content;
		margin-top: 0.25rem;
		transition: gap 0.15s ease;
	}
	.item-link:hover {
		gap: 0.55rem;
	}
	.item-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
		outline-offset: 2px;
	}

	/* ── Responsive ── */
	@media (max-width: 1024px) {
		.section-header {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
	@media (max-width: 768px) {
		.feature-band {
			grid-template-columns: 1fr;
			padding: 2rem 2rem 2.25rem;
		}
		.feature-icon {
			display: none;
		}
		.service-list {
			grid-template-columns: 1fr;
		}
		.service-item {
			padding: 2rem 0;
		}
		.service-item:nth-child(even) {
			padding-left: 0;
			border-left: none;
		}
	}
	@media (max-width: 640px) {
		.services {
			padding: 4.5rem 1.25rem 5.5rem;
		}
		.service-item {
			grid-template-columns: 3rem 1fr;
			gap: 1rem;
		}
		.item-num {
			font-size: 2rem;
		}
	}

	/* no-flash: initial states matched by JS animation targets */
	@media (prefers-reduced-motion: no-preference) {
		.eyebrow,
		.section-body {
			opacity: 0;
		}
		.section-title {
			clip-path: inset(0 0 100% 0);
		}
		.feature-band {
			opacity: 0;
		}
		.service-item {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".services", () => {
				(animate as any)(
					".services .eyebrow",
					{ opacity: [0, 1], y: [8, 0] },
					{ duration: 0.4, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .section-title",
					{ clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"], y: [20, 0] },
					{ duration: 0.65, delay: 0.05, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .section-body",
					{ opacity: [0, 1], y: [10, 0] },
					{ duration: 0.5, delay: 0.18, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .feature-band",
					{ opacity: [0, 1], y: [28, 0] },
					{ duration: 0.55, delay: 0.28, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .service-item",
					{ opacity: [0, 1], y: [20, 0] },
					{ duration: 0.5, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
				);
			});
		}
	});
</script>
