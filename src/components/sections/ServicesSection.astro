---
// ServicesSection.astro — three services side-by-side in a horizontal editorial strip.
import type { ServiceCard } from "../../types/ServiceCard";
import type { SectionHeading } from "../../types/SectionHeading";
import { icons } from "../../lib/utils/icons";
import { ui } from "../../lib/content/ui";
interface Props {
	heading: SectionHeading;
	services: ServiceCard[];
	bridge?: { text: string; href: string; ariaLabel: string };
}
const { heading, services, bridge } = Astro.props;
---

<section class="services" id="services">
	<div class="container">
		<header class="section-header">
			<div class="title-col">
				{heading.eyebrow && <span class="eyebrow">{heading.eyebrow}</span>}
				<h2 class="section-title">{heading.title}</h2>
			</div>
			<p class="section-body">{heading.body}</p>
		</header>

		<ul class="service-list" role="list">
			{
				services.map((service, i) => (
					<li class="service-col">
						<span class="col-num" aria-hidden="true">
							{(i + 1).toString().padStart(2, "0")}
						</span>
						<div class="col-body">
							<span class="col-icon" aria-hidden="true">
								<Fragment set:html={icons[service.iconName] ?? ""} />
							</span>
							<h3 class="col-title">{service.title}</h3>
							<p class="col-desc">{service.description}</p>
						</div>
						{service.href && (
							<a
								href={service.href}
								class="col-link"
								aria-label={`Explore ${service.title}`}
							>
								<span>{ui.exploreLabel}</span>
								<span aria-hidden="true">→</span>
							</a>
						)}
					</li>
				))
			}
		</ul>

		{bridge && (
			<a href={bridge.href} class="section-bridge" aria-label={bridge.ariaLabel}>
				<span class="bridge-text">{bridge.text}</span>
				<span class="bridge-arrow" aria-hidden="true">↓</span>
			</a>
		)}
	</div>
</section>

<style>
	.services {
		background: var(--color-bg-hero);
		padding: clamp(5rem, 8vw, 9rem) clamp(1.5rem, 8%, 6rem) clamp(4rem, 6vw, 7rem);
	}
	.container {
		max-width: 1280px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
	}

	/* ── Section header — two-column on desktop ── */
	.section-header {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: end;
	}
	.title-col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.eyebrow {
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.section-title {
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: var(--weight-extrabold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		line-height: 1.1;
	}
	.section-body {
		font-size: var(--text-base);
		color: var(--color-text-body);
		margin: 0;
		line-height: var(--leading-relaxed);
		max-width: 52ch;
		padding-bottom: 0.2rem;
	}

	/* ── Three-column service strip ── */
	.service-list {
		list-style: none;
		margin: clamp(3.5rem, 5vw, 5.5rem) 0 0;
		padding: 2.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.service-col {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 2.5rem 0;
		transition: background 0.22s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.service-col:hover {
		background: rgba(0, 193, 253, 0.08);
	}
	/* columns 1 and 4 — first in their row */
	.service-col:not(:nth-child(3n)) {
		padding-right: 3rem;
		border-right: 1px solid var(--color-border);
	}
	/* columns 2, 3, 5, 6 — not first in their row */
	.service-col:not(:nth-child(3n+1)) {
		padding-left: 3rem;
	}

	.col-num {
		font-size: clamp(2.75rem, 4vw, 4.5rem);
		font-weight: var(--weight-extrabold);
		color: oklch(91% 0.014 220);
		line-height: 1;
		letter-spacing: var(--tracking-tight);
	}

	.col-body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}
	.col-icon {
		width: 1.625rem;
		height: 1.625rem;
		color: var(--color-accent);
		display: flex;
		align-items: center;
		margin-bottom: 0.2rem;
	}
	.col-icon :global(svg) {
		width: 100%;
		height: 100%;
	}
	.col-title {
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		margin: 0;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}
	.col-desc {
		font-size: var(--text-sm);
		color: var(--color-text-body);
		margin: 0;
		line-height: var(--leading-relaxed);
	}

	.col-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 1rem;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-accent);
		text-decoration: none;
		transition:
			gap 0.18s cubic-bezier(0.22, 1, 0.36, 1),
			color 0.15s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.col-link:hover {
		color: var(--color-primary);
		gap: 0.7rem;
	}
	.col-link:active {
		opacity: 0.65;
	}
	.col-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* ── Responsive ── */

	@media (max-width: 1400px) {
		.section-bridge {
			display: none !important;
		}
	}

	@media (max-width: 1024px) {
		.service-list {
			grid-template-columns: 1fr;
			padding-top: 2rem;
		}
		.service-col {
			padding: 2rem 0;
			border-right: none;
		}
		.service-col:not(:last-child) {
			padding-right: 0;
			border-right: none;
			border-bottom: 1px solid var(--color-border);
		}
		.service-col:not(:first-child) {
			padding-left: 0;
		}
	}

	@media (max-width: 768px) {
		.services {
			padding: 4rem clamp(1.5rem, 5%, 3rem) 2rem;
		}
		.section-header {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.services {
			padding: 3.5rem 2rem 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.service-col,
		.col-link,
		.section-bridge {
			transition: none;
		}
	}

	/* ── Scroll bridge ── */
	.section-bridge {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		padding-top: 4rem;
		text-decoration: none;
		color: var(--color-text-body);
		opacity: 0.55;
		transition:
			opacity 0.18s ease,
			color 0.18s ease;
	}
	.section-bridge:hover {
		opacity: 1;
		color: var(--color-primary);
	}
	.section-bridge:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 4px;
		outline-offset: 4px;
	}
	.bridge-text {
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}
	.bridge-arrow {
		font-size: 1rem;
		line-height: 1;
		animation: bridge-nudge 2s ease-in-out infinite;
	}
	@keyframes bridge-nudge {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(5px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.bridge-arrow {
			animation: none;
		}
	}

	/* no-flash: initial states for animated elements */
	@media (prefers-reduced-motion: no-preference) {
		.eyebrow,
		.section-body {
			opacity: 0;
		}
		.section-title {
			clip-path: inset(0 0 100% 0);
		}
		.service-col {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".services", () => {
				(animate as any)(
					".services .eyebrow",
					{ opacity: [0, 1], y: [8, 0] },
					{ duration: 0.4, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .section-title",
					{ clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"], y: [20, 0] },
					{ duration: 0.65, delay: 0.05, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .section-body",
					{ opacity: [0, 1], y: [10, 0] },
					{ duration: 0.5, delay: 0.18, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".services .service-col",
					{ opacity: [0, 1], y: [20, 0] },
					{
						duration: 0.5,
						delay: (stagger as any)(0.1, { start: 0.28 }),
						easing: [0.22, 1, 0.36, 1],
					},
				);
			});
		}
	});
</script>
