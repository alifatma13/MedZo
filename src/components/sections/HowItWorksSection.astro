---
// HowItWorksSection.astro — numbered three-step process, horizontal on desktop.
import type { HowItWorksContent } from "../../types/HowItWorksContent";

interface Props extends HowItWorksContent {}
const { eyebrow, heading, subheading, steps } = Astro.props;
---

<section class="how-it-works" id="how-it-works">
	<div class="container">
		<div class="section-header">
			<span class="eyebrow">{eyebrow}</span>
			<h2 class="section-title">{heading}</h2>
			<p class="section-body">{subheading}</p>
		</div>

		<ol class="steps-list">
			{
				steps.map((step, i) => (
					<li class="step">
						<div class="step-marker">
							<span class="step-number" aria-hidden="true">{i + 1}</span>
						</div>
						<div class="step-content">
							<span class="step-label">{step.stepLabel}</span>
							<h3 class="step-title">{step.title}</h3>
							<p class="step-description">{step.description}</p>
							<ul class="step-bullets">
								{step.bullets.map((bullet) => (
									<li class="bullet-item">
										<span class="bullet-dot" aria-hidden="true" />
										{bullet}
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.how-it-works {
		background: oklch(99.5% 0.003 220);
		padding: 5rem clamp(1.5rem, 8%, 6rem) 7rem;
		/* Ensure anchor navigation never hides heading under the sticky nav */
		scroll-margin-top: 5rem;
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
	}

	/* ── Header ── */
	.section-header {
		text-align: center;
		margin-bottom: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.eyebrow {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.section-title {
		font-size: var(--text-4xl);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin: 0;
		white-space: nowrap;
	}

	.section-body {
		font-size: var(--text-base);
		color: var(--color-text-body);
		line-height: var(--leading-normal);
		margin: 0;
		max-width: 560px;
	}

	/* ── Steps grid ── */
	.steps-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		position: relative;
	}

	/* horizontal connector line between badge centres */
	.steps-list::before {
		content: "";
		position: absolute;
		top: 1.75rem; /* half of 3.5rem badge */
		left: calc((100% - 4rem) / 6);
		right: calc((100% - 4rem) / 6);
		height: 2px;
		background: linear-gradient(to right, var(--color-accent), rgba(0, 50, 125, 0.15));
		z-index: 0;
	}

	/* ── Individual step ── */
	.step {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: #fff;
		border-radius: 1rem;
		border: 1px solid rgba(0, 50, 125, 0.1);
		padding: 0 1.5rem 1.75rem;
		position: relative;
		z-index: 1;
	}

	/* ── Badge ── */
	.step-marker {
		display: flex;
		justify-content: center;
		margin-top: -1.75rem; /* pull badge up to sit on the connector line */
	}

	.step-number {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		background: var(--color-primary);
		color: #fff;
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 0 0 4px #fff, 0 0 0 6px rgba(0, 193, 253, 0.2);
	}

	/* ── Content ── */
	.step-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.step-label {
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.step-title {
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-snug);
		margin: 0;
	}

	.step-description {
		font-size: var(--text-sm);
		color: var(--color-text-body);
		line-height: var(--leading-normal);
		margin: 0;
	}

	.step-bullets {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.bullet-item {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: var(--text-sm);
		color: var(--color-text-body);
		line-height: var(--leading-normal);
	}

	.bullet-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-accent);
		flex-shrink: 0;
		margin-top: 0.45em;
	}

	/* no-flash: set initial opacity before JS animates in */
	@media (prefers-reduced-motion: no-preference) {
		.section-header,
		.step {
			opacity: 0;
		}
	}

	/* ── Tablet and below ── */
	@media (max-width: 900px) {
		.how-it-works {
			padding: 4rem clamp(1.5rem, 6%, 4rem) 5rem;
		}

		.section-title {
			white-space: normal;
			font-size: var(--text-3xl);
		}

		.steps-list {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.steps-list::before {
			display: none;
		}

		.step {
			padding: 1.25rem;
			flex-direction: row;
			align-items: flex-start;
			gap: 1rem;
		}

		.step-marker {
			margin-top: 0;
			flex-shrink: 0;
		}
	}

	/* ── Mobile ── */
	@media (max-width: 480px) {
		.section-title {
			font-size: var(--text-2xl);
		}

		.step-marker {
			justify-content: flex-start;
			margin-top: 0;
		}

		.step-number {
			width: 2rem;
			height: 2rem;
			font-size: var(--text-sm);
		}

		.step {
			flex-direction: column;
			gap: 0.75rem;
		}

		.step-title {
			font-size: var(--text-lg);
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".how-it-works .section-header", () => {
				const header = document.querySelector(".how-it-works .section-header");
				if (header)
					(animate as any)(
						header,
						{ opacity: [0, 1], y: [24, 0] },
						{ duration: 0.6, easing: [0.22, 1, 0.36, 1] },
					);
			});

			inView(".how-it-works .steps-list", () => {
				const steps = document.querySelectorAll(".how-it-works .step");
				if (steps.length) {
					(animate as any)(
						steps,
						{ opacity: [0, 1], y: [32, 0] },
						{ duration: 0.5, delay: stagger(0.15), easing: [0.22, 1, 0.36, 1] },
					);
				}
			});
		}
	});
</script>
