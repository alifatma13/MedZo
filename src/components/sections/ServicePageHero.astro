---
// ServicePageHero.astro — light split-layout hero for individual service pages.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { icons } from "../../lib/utils/icons";
interface Props {
  label: string;
  heading: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
  heroImage: ImageMetadata;
}
const { label, heading, intro, ctaLabel, ctaHref, heroImage } = Astro.props;
---

<section class="svc-hero">
  <div class="container">
    <div class="hero-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">{label}</span>
      </nav>
      <h1 class="hero-heading">{heading}</h1>
      <p class="hero-intro">{intro}</p>
      <div class="hero-actions">
        <a href={ctaHref} class="hero-cta">{ctaLabel} <span aria-hidden="true">→</span></a>
        <a href="/#services" class="hero-back">View all services</a>
      </div>
    </div>

    <div class="hero-visual">
      <!-- Dot-grid decoration (top-right corner) -->
      <div class="vis-dots" aria-hidden="true"></div>
      <!-- Soft gradient wash behind the photo -->
      <div class="vis-backdrop" aria-hidden="true"></div>
      <!-- Photo frame — overflow-hidden so the badge clips correctly -->
      <div class="vis-frame">
        <Image
          src={heroImage}
          alt=""
          class="hero-img"
          width={heroImage.width}
          height={heroImage.height}
        />
        <!-- Decorative trust chip (aria-hidden — purely visual) -->
        <div class="vis-badge" aria-hidden="true">
          <span class="vis-badge-icon">
            <Fragment set:html={icons["shield-check"]} />
          </span>
          <span class="vis-badge-text">Australian Healthcare</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .svc-hero {
    background: #fff;
    padding: 6rem clamp(1.5rem, 8%, 6rem) 4rem;
    overflow: hidden;
    position: relative;
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }
  .crumb-link {
    color: var(--color-text-body);
    text-decoration: none;
    transition: color 0.15s;
  }
  .crumb-link:hover { color: var(--color-primary); }
  .crumb-sep { color: var(--color-text-body); opacity: 0.5; }
  .crumb-current {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }
  .hero-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--weight-extrabold);
    color: var(--color-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .hero-intro {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 520px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gradient-brand);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 0.625rem;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 193, 253, 0.3);
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 32px rgba(0, 193, 253, 0.4);
  }
  .hero-cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }
  .hero-back {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-body);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 50, 125, 0.25);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .hero-back:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }
  .hero-back:focus-visible {
    outline: 2px solid var(--color-accent);
    border-radius: 2px;
  }

  /* ── Image visual ────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    /* Padding so dot grid and offset can bleed outside the photo */
    padding: 1rem 0 1rem 1rem;
  }

  /* Repeating dot-grid — top-right corner decoration */
  .vis-dots {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    width: 180px;
    height: 180px;
    background-image: radial-gradient(circle, rgba(0, 193, 253, 0.35) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 0;
  }

  /* Gradient wash that sits behind the photo frame */
  .vis-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 193, 253, 0.07) 0%,
      rgba(0, 50, 125, 0.05) 100%
    );
    border-radius: 2rem;
    z-index: 0;
  }

  /* Photo frame — overflow hidden keeps badge inside the rounded corners */
  .vis-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow:
      0 40px 90px rgba(0, 50, 125, 0.18),
      0 12px 30px rgba(0, 193, 253, 0.14),
      0 0 0 1px rgba(0, 193, 253, 0.14);
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Frosted-glass trust badge floating over the photo */
  .vis-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(0, 193, 253, 0.22);
    border-radius: 2rem;
    padding: 0.45rem 0.875rem 0.45rem 0.6rem;
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    letter-spacing: 0.04em;
    box-shadow: 0 4px 16px rgba(0, 50, 125, 0.1);
    white-space: nowrap;
  }
  .vis-badge-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .vis-badge-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .container { grid-template-columns: 1fr; gap: 2.5rem; }
    .vis-frame { max-width: 480px; margin: 0 auto; }
  }
  @media (max-width: 640px) {
    .svc-hero { padding: 4rem 1.5rem 3rem; }
    .container { max-width: none; }
    .hero-visual { display: none; }
    .hero-actions { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta { transition: none; }
  }
</style>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero {
      opacity: 0;
    }
  }
</style>

<script>
  import { animate } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      (animate as any)(
        ".svc-hero",
        { opacity: [0, 1] },
        { duration: 0.3, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".svc-hero .breadcrumb",
        { y: [10, 0] },
        { duration: 0.4, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".svc-hero .hero-heading",
        { y: [24, 0] },
        { duration: 0.6, delay: 0.08, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".svc-hero .hero-intro",
        { y: [18, 0] },
        { duration: 0.55, delay: 0.18, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".svc-hero .hero-actions",
        { y: [14, 0] },
        { duration: 0.5, delay: 0.28, easing: [0.22, 1, 0.36, 1] },
      );
      (animate as any)(
        ".svc-hero .hero-visual",
        { x: [32, 0] },
        { duration: 0.65, delay: 0.15, easing: [0.22, 1, 0.36, 1] },
      );
    }
  });
</script>
