---
// FounderSection.astro — editorial split: full-bleed portrait left, founder biography right.
// Founder data comes from the Sanity aboutPage singleton via getAboutPage().
import { Image } from "astro:assets";
import { urlFor } from "../../lib/utils/sanityImage";
import type { SanityImage } from "../../types/SanityImage";

interface SanityFounder {
  sectionHeading: string;
  intro: string;
  name: string;
  role: string;
  bio: string[];
  photo?: SanityImage | null;
}
interface Props {
  founder: SanityFounder;
}
const { founder } = Astro.props;
---

<section class="founder">
	<div class="split">
		<div class="photo-panel">
			{founder.photo?.asset ? (
				<Image
					src={urlFor(founder.photo).width(640).height(800).fit("crop").format("webp").url()}
					alt={founder.photo.alt ?? `Portrait of ${founder.name}`}
					class="portrait"
					width={640}
					height={800}
					loading="lazy"
				/>
			) : (
				<div class="portrait-fallback" aria-hidden="true">
					{founder.name.split(" ").map((w) => w[0]).join("")}
				</div>
			)}
		</div>

		<div class="content">
			<p class="kicker">{founder.sectionHeading}</p>
			<h2 class="name">{founder.name}</h2>
			<p class="role">{founder.role}</p>
			<hr class="divider" aria-hidden="true" />
			<p class="intro">{founder.intro}</p>
			{founder.bio.map((para) => <p class="bio">{para}</p>)}
		</div>
	</div>
</section>

<style>
	.founder {
		background: oklch(99% 0.005 220);
		overflow: hidden;
	}

	/* ── Split layout ── */
	.split {
		display: grid;
		grid-template-columns: 40fr 60fr;
		min-height: 580px;
	}

	/* ── Photo: bleeds to left edge ── */
	.photo-panel {
		position: relative;
		overflow: hidden;
	}
	.portrait {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 12%;
		display: block;
		transition:
			filter 0.5s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: filter, transform;
	}
	/* Delight: portrait warms and breathes in when you look at it */
	.photo-panel:hover .portrait {
		filter: brightness(1.07) saturate(1.06);
		transform: scale(1.025);
	}
	/* Delight: editorial right-edge blend where photo meets content */
	.photo-panel::after {
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 90px;
		background: linear-gradient(to right, transparent, oklch(99% 0.005 220));
		z-index: 1;
		pointer-events: none;
	}
	.portrait-fallback {
		position: absolute;
		inset: 0;
		background: oklch(95% 0.02 220);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 5rem;
		font-weight: var(--weight-extrabold);
		color: var(--color-accent);
		letter-spacing: 0.04em;
	}

	/* ── Content column ── */
	.content {
		padding: 5.5rem clamp(2rem, 6%, 5rem) 5.5rem clamp(2.5rem, 5%, 4.5rem);
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.kicker {
		font-size: var(--text-xs);
		font-family: var(--font-nav);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
	}
	.name {
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: var(--weight-extrabold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: 1.08;
		margin: 0;
		/* Delight: accent underline draws on hover — reward for pausing on the name */
		position: relative;
		display: inline-block;
	}
	.name::after {
		content: "";
		position: absolute;
		bottom: -3px;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.name:hover::after {
		transform: scaleX(1);
	}
	.role {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-body);
		margin: 0;
		letter-spacing: 0.01em;
	}
	/* Delight: divider draws left-to-right — "the story begins here" */
	.divider {
		border: none;
		border-top: 1px solid oklch(88% 0.014 220);
		margin: 0.5rem 0;
		width: 100%;
		transform-origin: left center;
	}
	.intro {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		line-height: var(--leading-snug);
		margin: 0;
		max-width: 60ch;
	}
	.bio {
		font-size: var(--text-base);
		color: var(--color-text-body);
		line-height: var(--leading-loose);
		margin: 0;
		max-width: 68ch;
	}

	/* ── Responsive ── */
	@media (max-width: 960px) {
		.split {
			grid-template-columns: 1fr;
			min-height: auto;
		}
		.photo-panel {
			aspect-ratio: 3 / 2;
			position: relative;
		}
		/* Edge blend makes less sense on stacked layout */
		.photo-panel::after {
			display: none;
		}
		.content {
			padding: 3.5rem clamp(1.5rem, 6%, 4rem);
		}
	}
	@media (max-width: 640px) {
		.photo-panel {
			aspect-ratio: 4 / 3;
		}
		.content {
			padding: 3rem 1.5rem 4rem;
		}
		.name {
			font-size: clamp(1.75rem, 7vw, 2.25rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait {
			transition: none;
		}
		.photo-panel,
		.kicker,
		.name,
		.role,
		.intro,
		.bio {
			opacity: 1;
		}
		.divider {
			transform: scaleX(1);
		}
	}

	/* ── No-flash: individual elements hidden before JS orchestrates them ── */
	@media (prefers-reduced-motion: no-preference) {
		.photo-panel {
			opacity: 0;
		}
		.kicker,
		.name,
		.role,
		.intro,
		.bio {
			opacity: 0;
		}
		.divider {
			transform: scaleX(0);
		}
	}
</style>

<script>
	import { animate, inView } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		inView(".founder", () => {
			// Portrait slides in from the left
			(animate as any)(
				".founder .photo-panel",
				{ opacity: [0, 1], x: [-32, 0] },
				{ duration: 0.75, easing: [0.22, 1, 0.36, 1] },
			);

			// Text elements arrive in sequence — like being introduced
			(animate as any)(
				".founder .kicker",
				{ opacity: [0, 1], y: [10, 0] },
				{ duration: 0.4, delay: 0.22, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".founder .name",
				{ opacity: [0, 1], y: [18, 0] },
				{ duration: 0.55, delay: 0.34, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".founder .role",
				{ opacity: [0, 1], y: [10, 0] },
				{ duration: 0.4, delay: 0.46, easing: [0.22, 1, 0.36, 1] },
			);

			// Divider draws from left — the story begins
			(animate as any)(
				".founder .divider",
				{ scaleX: [0, 1] },
				{ duration: 0.5, delay: 0.56, easing: [0.22, 1, 0.36, 1] },
			);

			(animate as any)(
				".founder .intro",
				{ opacity: [0, 1], y: [12, 0] },
				{ duration: 0.5, delay: 0.68, easing: [0.22, 1, 0.36, 1] },
			);

			// Bio paragraphs stagger in
			const bios = document.querySelectorAll<HTMLElement>(".founder .bio");
			bios.forEach((bio, i) => {
				(animate as any)(
					bio,
					{ opacity: [0, 1], y: [10, 0] },
					{ duration: 0.45, delay: 0.78 + i * 0.1, easing: [0.22, 1, 0.36, 1] },
				);
			});
		});
	});
</script>
