---
// FounderSection.astro — editorial split: full-bleed portrait left, founder biography right.
import type { AboutFounder } from "../../types/AboutContent";
interface Props {
	founder: AboutFounder;
}
const { founder } = Astro.props;
---

<section class="founder">
	<div class="split">
		<div class="photo-panel">
			{founder.imageUrl ? (
				<img
					src={founder.imageUrl}
					alt={`Portrait of ${founder.name}`}
					class="portrait"
					loading="lazy"
				/>
			) : (
				<div class="portrait-fallback" aria-hidden="true">
					{founder.name.split(" ").map((w) => w[0]).join("")}
				</div>
			)}
		</div>

		<div class="content">
			<p class="kicker">{founder.sectionHeading}</p>
			<h2 class="name">{founder.name}</h2>
			<p class="role">{founder.role}</p>
			<hr class="divider" aria-hidden="true" />
			<p class="intro">{founder.intro}</p>
			{founder.bio.map((para) => <p class="bio">{para}</p>)}
		</div>
	</div>
</section>

<style>
	.founder {
		background: oklch(99% 0.005 220);
		overflow: hidden;
	}

	/* ── Split layout ── */
	.split {
		display: grid;
		grid-template-columns: 40fr 60fr;
		min-height: 580px;
	}

	/* ── Photo: bleeds to left edge, no card treatment ── */
	.photo-panel {
		position: relative;
	}
	.portrait {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 12%;
		display: block;
	}
	.portrait-fallback {
		position: absolute;
		inset: 0;
		background: oklch(95% 0.02 220);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 5rem;
		font-weight: var(--weight-extrabold);
		color: var(--color-accent);
		letter-spacing: 0.04em;
	}

	/* ── Content column ── */
	.content {
		padding: 5.5rem clamp(2rem, 6%, 5rem) 5.5rem clamp(2.5rem, 5%, 4.5rem);
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.kicker {
		font-size: var(--text-xs);
		font-family: var(--font-nav);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
	}
	.name {
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: var(--weight-extrabold);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tight);
		line-height: 1.08;
		margin: 0;
	}
	.role {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-body);
		margin: 0;
		letter-spacing: 0.01em;
	}
	.divider {
		border: none;
		border-top: 1px solid oklch(88% 0.014 220);
		margin: 0.5rem 0;
		width: 100%;
	}
	.intro {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		line-height: var(--leading-snug);
		margin: 0;
		max-width: 60ch;
	}
	.bio {
		font-size: var(--text-base);
		color: var(--color-text-body);
		line-height: var(--leading-loose);
		margin: 0;
		max-width: 68ch;
	}

	/* ── Responsive ── */
	@media (max-width: 960px) {
		.split {
			grid-template-columns: 1fr;
			min-height: auto;
		}
		.photo-panel {
			aspect-ratio: 3 / 2;
			position: relative;
		}
		.content {
			padding: 3.5rem clamp(1.5rem, 6%, 4rem);
		}
		.intro,
		.bio {
			max-width: none;
		}
	}
	@media (max-width: 640px) {
		.photo-panel {
			aspect-ratio: 4 / 3;
		}
		.content {
			padding: 3rem 1.5rem 4rem;
		}
		.name {
			font-size: clamp(1.75rem, 7vw, 2.25rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo-panel,
		.content {
			opacity: 1;
		}
	}

	/* no-flash */
	@media (prefers-reduced-motion: no-preference) {
		.photo-panel,
		.content {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		inView(".founder", () => {
			(animate as any)(
				".founder .photo-panel",
				{ opacity: [0, 1], x: [-32, 0] },
				{ duration: 0.7, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".founder .content",
				{ opacity: [0, 1], y: [24, 0] },
				{ duration: 0.65, delay: 0.18, easing: [0.22, 1, 0.36, 1] },
			);
		});
	});
</script>
