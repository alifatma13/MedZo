---
// FinalCTA.astro — full-width bottom call-to-action banner with a gradient overlay and a single button.
import Button from "../ui/Button.astro";
import type { FinalCta } from "../../types/content";
interface Props extends FinalCta {}
const { heading, subheading, buttonLabel, buttonHref } = Astro.props;
---

<section class="final-cta" id="contact">
	<div class="gradient-overlay"></div>
	<div class="blob blob-1" aria-hidden="true"></div>
	<div class="blob blob-2" aria-hidden="true"></div>
	<div class="container">
		<h2 class="cta-heading">{heading}</h2>
		{subheading && <p class="cta-subheading">{subheading}</p>}
		<Button label={buttonLabel} href={buttonHref} variant="accent" />
	</div>
</section>

<style>
	.final-cta {
		background: var(--color-primary);
		padding: 6rem clamp(1.5rem, 8%, 6rem);
		position: relative;
		overflow: hidden;
		text-align: center;
	}
	.gradient-overlay {
		position: absolute;
		inset: 0;
		opacity: 0.1;
		background: radial-gradient(ellipse at center, #fff 0%, transparent 70%);
		pointer-events: none;
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}
	.blob-1 {
		width: 500px;
		height: 500px;
		top: -120px;
		right: -80px;
		background: radial-gradient(circle, rgba(0, 193, 253, 0.35) 0%, transparent 65%);
	}
	.blob-2 {
		width: 380px;
		height: 380px;
		bottom: -100px;
		left: -60px;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.14) 0%, transparent 65%);
	}
	.container {
		position: relative;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}
	.cta-heading {
		font-size: clamp(1.75rem, 3.5vw, 3rem);
		font-weight: var(--weight-bold);
		color: oklch(98% 0.006 220);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		max-width: 72rem;
		line-height: 1.2;
	}
	.cta-subheading {
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		color: oklch(92% 0.01 220 / 0.85);
		line-height: 1.6;
		margin: 0;
		max-width: 56ch;
	}
	@media (max-width: 768px) {
		.final-cta {
			padding: 4rem clamp(1.5rem, 5%, 3rem);
		}
	}
	@media (max-width: 640px) {
		.final-cta {
			padding: 4rem 1.5rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.cta-heading,
		.cta-subheading,
		.btn {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".final-cta", () => {
				(animate as any)(
					".final-cta .cta-heading",
					{ opacity: [0, 1], y: [24, 0] },
					{ duration: 0.6, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".final-cta .cta-subheading",
					{ opacity: [0, 1], y: [16, 0] },
					{ duration: 0.5, delay: 0.15, easing: [0.22, 1, 0.36, 1] },
				);
				(animate as any)(
					".final-cta .btn",
					{ opacity: [0, 1], y: [16, 0] },
					{ duration: 0.5, delay: 0.3, easing: [0.22, 1, 0.36, 1] },
				);
			});
		}
	});
</script>
