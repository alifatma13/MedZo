---
// AboutHeroSection.astro — split-layout about hero: bold heading left, mission paragraphs right.
interface Props {
	title: string;
	heading: string;
	paragraphs: string[];
}
const { heading, paragraphs } = Astro.props;
---

<section class="about-hero">
	<div class="inner">
		<div class="heading-col">
			<h1 class="heading">{heading}</h1>
		</div>
		<div class="body-col">
			{paragraphs.map((p) => <p class="body-para">{p}</p>)}
		</div>
	</div>
</section>

<style>
	.about-hero {
		background: var(--color-primary);
		padding: 6rem clamp(1.5rem, 8%, 6rem);
	}
	.inner {
		max-width: 1280px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 56fr 44fr;
		gap: 5rem;
		align-items: center;
	}
	.heading-col {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
.heading {
		font-size: clamp(2.25rem, 4.5vw, 3.75rem);
		font-weight: var(--weight-extrabold);
		color: oklch(98% 0.006 220);
		letter-spacing: var(--tracking-tight);
		line-height: 1.08;
		margin: 0;
	}
	.heading::after {
		content: '';
		display: block;
		margin-top: 1.25rem;
		width: 3rem;
		height: 4px;
		border-radius: 2px;
		background: var(--color-highlight);
	}
	.body-col {
		display: flex;
		flex-direction: column;
		gap: 1.375rem;
	}
	.body-para {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.62);
		line-height: var(--leading-loose);
		margin: 0;
		max-width: 65ch;
	}

	@media (max-width: 1024px) {
		.about-hero {
			padding: 5rem clamp(1.5rem, 6%, 4rem) 4.5rem;
		}
		.inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
	@media (max-width: 640px) {
		.about-hero {
			padding: 5rem 1.5rem 4rem;
		}
		.heading {
			font-size: clamp(1.875rem, 7vw, 2.5rem);
		}
	}

	/* no-flash: initial states for animated elements */
	@media (prefers-reduced-motion: no-preference) {
		.heading,
		.body-col {
			opacity: 0;
		}
	}
</style>

<script>
	// Page-load fade-in for the accent bar, heading, and body column.
	import { animate } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		(animate as any)(
			".about-hero .heading",
			{ opacity: [0, 1], y: [28, 0] },
			{ duration: 0.65, delay: 0.08, easing: [0.22, 1, 0.36, 1] },
		);
		(animate as any)(
			".about-hero .body-col",
			{ opacity: [0, 1], y: [18, 0] },
			{ duration: 0.6, delay: 0.22, easing: [0.22, 1, 0.36, 1] },
		);
	});
</script>
