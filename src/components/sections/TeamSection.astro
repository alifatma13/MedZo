---
// TeamSection.astro — team member carousel used on the /about page.
// Members come from the Sanity teamMember collection via getTeamMembers().
import { Image } from "astro:assets";
import { icons } from "../../lib/utils/icons";
import { ui } from "../../lib/content/ui";
import { urlFor } from "../../lib/utils/sanityImage";
import type { SanityImage } from "../../types/SanityImage";

interface SanityMember {
  _id: string;
  name: string;
  role: string;
  bio: string;
  photo?: SanityImage | null;
}
interface Props {
	heading: string;
	body: string;
	members: SanityMember[];
}
const { heading, body, members } = Astro.props;

function initials(name: string): string {
	const parts = name.trim().split(/\s+/);
	return (parts[0][0] + (parts[parts.length - 1][0] ?? "")).toUpperCase();
}

function shortenName(name: string): string {
	const parts = name.trim().split(/\s+/);
	if (parts.length === 1) return parts[0];
	return `${parts[0]} ${parts[parts.length - 1][0].toUpperCase()}.`;
}
---

<section class="team" id="team">
	<div class="container">
		<div class="section-header">
			<h2 class="section-title">{heading}</h2>
			<p class="section-body">{body}</p>
		</div>
		<div class="carousel-wrap">
			<button class="arrow arrow-prev" aria-label={ui.scrollLeftLabel}>
				<Fragment set:html={icons["carousel-prev"]} />
			</button>
			<div class="track">
				{
					members.map((member) => (
						<article class="card">
							<div class="photo-wrap">
								{member.photo?.asset ? (
									<Image
										src={urlFor(member.photo).width(176).height(176).fit("crop").format("webp").url()}
										alt={member.photo.alt ?? `Photo of ${member.name}`}
										class="photo"
										width={176}
										height={176}
										loading="lazy"
									/>
								) : (
									<div class="initials" aria-hidden="true">{initials(member.name)}</div>
								)}
							</div>
							<div class="card-body">
								<p class="member-role">{member.role}</p>
								<h3 class="member-name">{shortenName(member.name)}</h3>
								<p class="member-bio">{member.bio}</p>
							<button
								class="read-more"
								aria-expanded="false"
								data-label-read-more={ui.readMoreLabel}
								data-label-read-less={ui.readLessLabel}
							>{ui.readMoreLabel}</button>
							</div>
						</article>
					))
				}
			</div>
			<button class="arrow arrow-next" aria-label={ui.scrollRightLabel}>
				<Fragment set:html={icons["carousel-next"]} />
			</button>
		</div>
	</div>
</section>

<style>
	.team {
		background: transparent;
		padding: 5rem clamp(1.5rem, 8%, 6rem);
		position: relative;
		z-index: 1;
	}
	.container {
		max-width: 1280px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	/* ── Header ──────────────────────────────────────────── */
	.section-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.6rem;
	}
	.section-title {
		font-size: clamp(1.75rem, 3.5vw, 3rem);
		font-weight: var(--weight-extrabold);
		color: #fff;
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}
	.section-body {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
	}

	/* ── Carousel ────────────────────────────────────────── */
	.carousel-wrap {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.track {
		flex: 1;
		display: flex;
		gap: 1.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 0.25rem;
		scrollbar-width: none;
	}
	.track::-webkit-scrollbar {
		display: none;
	}

	/* ── Arrow buttons ───────────────────────────────────── */
	.arrow {
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: 1.5px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		/* Delight: scale gives tactile press feedback */
		transition:
			background 0.18s cubic-bezier(0.22, 1, 0.36, 1),
			border-color 0.18s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.arrow:hover {
		background: var(--color-accent);
		border-color: var(--color-accent-text);
		transform: scale(1.12);
	}
	.arrow:active {
		transform: scale(0.95);
	}
	.arrow:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.arrow:disabled {
		opacity: 0.25;
		cursor: default;
		pointer-events: none;
	}

	/* ── Card ────────────────────────────────────────────── */
	.card {
		flex: 0 0 270px;
		scroll-snap-align: start;
		background: oklch(99% 0.005 220);
		border-radius: 1.25rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
		transition:
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.card:hover {
		transform: translateY(-6px);
		box-shadow:
			0 16px 48px rgba(0, 0, 0, 0.28),
			0 0 0 1px rgba(0, 193, 253, 0.15);
	}

	/* ── Photo ───────────────────────────────────────────── */
	.photo-wrap {
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		margin: 1.75rem auto 0;
		border: 3px solid rgba(0, 193, 253, 0.2);
		box-shadow: 0 2px 12px rgba(0, 50, 125, 0.12);
		background: rgba(0, 193, 253, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		/* Delight: ring brightens when you look at this person */
		transition:
			border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	/* Delight: hovering a card makes the person's avatar ring glow */
	.card:hover .photo-wrap {
		border-color: rgba(0, 193, 253, 0.75);
		box-shadow:
			0 2px 12px rgba(0, 50, 125, 0.12),
			0 0 0 4px rgba(0, 193, 253, 0.12);
	}
	.initials {
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		color: var(--color-accent-text);
		letter-spacing: 0.02em;
	}
	.photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		/* Delight: portrait steps slightly forward when you hover the card */
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.card:hover .photo {
		transform: scale(1.07);
	}

	/* ── Card text ───────────────────────────────────────── */
	.card-body {
		padding: 1rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.3rem;
		flex: 1;
	}
	.member-role {
		font-size: var(--text-xs);
		font-family: var(--font-nav);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--color-accent-text);
		margin: 0 0 0.25rem;
		min-height: 2.5rem;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}
	.member-name {
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		margin: 0 0 0.5rem;
		line-height: var(--leading-tight);
	}
	.member-bio {
		font-size: var(--text-sm);
		color: var(--color-text-body);
		line-height: var(--leading-loose);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.member-bio.expanded {
		display: block;
		-webkit-line-clamp: unset;
		overflow: visible;
	}
	.read-more {
		background: none;
		border: none;
		padding: 0;
		margin-top: 0.4rem;
		font-size: var(--text-xs);
		font-family: var(--font-nav);
		font-weight: var(--weight-semibold);
		color: var(--color-accent-text);
		cursor: pointer;
		letter-spacing: 0.03em;
		text-align: center;
		width: fit-content;
		transition: opacity 0.15s;
	}
	.read-more:hover {
		text-decoration: underline;
	}
	.read-more:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: 2px;
	}

	/* ── Responsive ──────────────────────────────────────── */
	@media (max-width: 900px) {
		.team {
			padding: 4rem clamp(1.5rem, 6%, 4rem);
		}
	}
	@media (max-width: 768px) {
		.team {
			padding: 4rem clamp(1.5rem, 5%, 3rem);
		}
	}
	@media (max-width: 640px) {
		.team {
			padding: 4.5rem clamp(1.5rem, 5%, 2rem);
		}
		.card {
			flex: 0 0 calc(80vw - 2.5rem);
			max-width: 280px;
		}
		.arrow {
			display: none;
		}
		.carousel-wrap {
			gap: 0;
		}
	}

	/* ── No-flash: set initial states before JS animates ─── */
	@media (prefers-reduced-motion: no-preference) {
		.section-title,
		.section-body,
		.card {
			opacity: 0;
		}
		/* Photo starts slightly scaled down — pops into place after card enters */
		.photo-wrap {
			transform: scale(0.82);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo-wrap,
		.photo,
		.card,
		.arrow {
			transition: none;
		}
		.photo-wrap {
			transform: none;
		}
	}
</style>

<script>
	import { animate, inView, stagger } from "motion";

	document.addEventListener("astro:page-load", () => {
		const track = document.querySelector(".team .track") as HTMLElement | null;
		const prevBtn = document.querySelector(".team .arrow-prev") as HTMLButtonElement | null;
		const nextBtn = document.querySelector(".team .arrow-next") as HTMLButtonElement | null;

		// Shuffle card order — different every visit (already a delight; preserve it)
		if (track) {
			const cards = [...track.children];
			for (let i = cards.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[cards[i], cards[j]] = [cards[j], cards[i]];
			}
			cards.forEach((card) => track.appendChild(card));
			track.scrollLeft = 0;
		}

		// Read more toggle
		document.querySelectorAll<HTMLButtonElement>(".team .read-more").forEach((btn) => {
			const bio = btn.previousElementSibling as HTMLElement;
			btn.addEventListener("click", () => {
				const expanded = bio.classList.toggle("expanded");
				btn.textContent = expanded ? (btn.dataset.labelReadLess ?? "Read less") : (btn.dataset.labelReadMore ?? "Read more");
				btn.setAttribute("aria-expanded", String(expanded));
			});
		});

		// Arrow scroll
		if (track && prevBtn && nextBtn) {
			const SCROLL_AMOUNT = 295;
			const updateArrows = () => {
				prevBtn.disabled = track.scrollLeft <= 0;
				nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
			};
			prevBtn.addEventListener("click", () => {
				track.scrollBy({ left: -SCROLL_AMOUNT, behavior: "smooth" });
			});
			nextBtn.addEventListener("click", () => {
				track.scrollBy({ left: SCROLL_AMOUNT, behavior: "smooth" });
			});
			track.addEventListener("scroll", updateArrows, { passive: true });
			updateArrows();
		}

		// Entrance animations
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			inView(".team", () => {
				// Header fades in
				(animate as any)(
					".team .section-title, .team .section-body",
					{ opacity: [0, 1], y: [16, 0] },
					{ duration: 0.5, easing: [0.22, 1, 0.36, 1] },
				);

				// Cards stagger in from below
				(animate as any)(
					".team .card",
					{ opacity: [0, 1], y: [36, 0] },
					{ duration: 0.5, delay: stagger(0.08, { startDelay: 0.15 }), easing: [0.22, 1, 0.36, 1] },
				);

				// Delight: after each card arrives, its avatar circle pops into full size.
				// startDelay 0.38s means photos start popping 0.23s after the first card begins entering.
				// The stagger matches the card stagger so each photo pops shortly after ITS card appears.
				(animate as any)(
					".team .photo-wrap",
					{ scale: [0.82, 1] },
					{ duration: 0.45, delay: stagger(0.08, { startDelay: 0.38 }), easing: [0.22, 1, 0.36, 1] },
				);
			});
		}
	});
</script>
