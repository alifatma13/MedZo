---
// SpecialtyTicker.astro — drenched-navy two-row marquee with dashed-border ticket tags.
import type { TickerContent } from "../../types/TickerContent";
interface Props extends TickerContent {}
const { intro, specialties } = Astro.props;

// Duplicate for seamless CSS loop
const row1 = [...specialties, ...specialties];
const row2 = [...[...specialties].reverse(), ...[...specialties].reverse()];
---

<section class="ticker" aria-label="Specialties we support">

  <div class="ticker-head">
    <p class="ticker-intro">{intro}</p>
  </div>

  <!-- aria-hidden: presentational; accessible fallback below -->
  <div class="ticker-stage" aria-hidden="true">

    <!-- Row 1: scrolls left — dashed accent border, beats every 3rd -->
    <div class="track-wrap">
      <div class="track track--fwd">
        {row1.map((s, i) => (
          <>
            <span class:list={["tag", { "tag--beat": i % 3 === 0 }]}>{s}</span>
            <span class="sep">◆</span>
          </>
        ))}
      </div>
    </div>

    <!-- Row 2: scrolls right — dimmer, smaller -->
    <div class="track-wrap">
      <div class="track track--rev">
        {row2.map((s) => (
          <>
            <span class="tag tag--bg">{s}</span>
            <span class="sep sep--bg">◆</span>
          </>
        ))}
      </div>
    </div>

  </div>

  <p class="sr-only">{specialties.join(", ")}</p>

</section>

<style>
  /* ── Section ───────────────────────────────────────────── */
  .ticker {
    background: var(--color-primary);
    padding: 6rem 0;
    overflow: hidden;
    position: relative;
  }
  .ticker::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 85% 110% at 50% 50%,
      rgba(0, 193, 253, 0.08) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  /* ── Intro ─────────────────────────────────────────────── */
  .ticker-head {
    padding: 0 clamp(1.5rem, 8%, 6rem) 3.5rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .ticker-intro {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    color: oklch(88% 0.02 210);
    margin: 0 auto;
    max-width: 56ch;
    line-height: 1.45;
  }

  /* ── Stage + edge vignette ─────────────────────────────── */
  .ticker-stage {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    position: relative;
  }
  .ticker-stage::before,
  .ticker-stage::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 16%;
    pointer-events: none;
    z-index: 2;
  }
  .ticker-stage::before {
    left: 0;
    background: linear-gradient(to right, rgba(0, 50, 125, 1), rgba(0, 50, 125, 0));
  }
  .ticker-stage::after {
    right: 0;
    background: linear-gradient(to left, rgba(0, 50, 125, 1), rgba(0, 50, 125, 0));
  }

  /* ── Tracks ────────────────────────────────────────────── */
  .track-wrap {
    overflow: hidden;
    width: 100%;
  }
  .track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }
  .track--fwd {
    animation: scroll-left 32s linear infinite;
  }
  .track--rev {
    animation: scroll-right 52s linear infinite;
    animation-delay: -18s;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes scroll-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  /* ── Ticket tags — dashed border ───────────────────────── */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.6rem;
    border-radius: 5px;
    border: 1.5px dashed rgba(0, 193, 253, 0.45);
    color: oklch(91% 0.018 210);
    font-family: var(--font-nav);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    letter-spacing: 0.015em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* Beat — solid border + faint fill so it pops from the dashed stream */
  .tag--beat {
    border-style: solid;
    border-color: rgba(0, 193, 253, 0.65);
    background: rgba(0, 193, 253, 0.09);
    color: oklch(94% 0.025 210);
  }
  /* Background row — smaller, very dim dashes */
  .tag--bg {
    padding: 0.45rem 1.25rem;
    font-size: var(--text-sm);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    color: oklch(62% 0.01 220);
  }

  /* ── Separators ────────────────────────────────────────── */
  .sep {
    color: var(--color-accent);
    font-size: 0.45rem;
    margin: 0 1.5rem;
    opacity: 0.6;
    flex-shrink: 0;
    line-height: 1;
  }
  .sep--bg {
    color: oklch(55% 0.008 220);
    opacity: 0.28;
    margin: 0 1.25rem;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 768px) {
    .ticker {
      padding: 4rem 0;
    }
    .ticker-head {
      padding-bottom: 2.5rem;
    }
  }
  @media (max-width: 480px) {
    .ticker {
      padding: 3.5rem 0;
    }
    .ticker-head {
      padding-bottom: 2rem;
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .track--fwd,
    .track--rev {
      animation-play-state: paused;
    }
  }

  /* ── No-flash ───────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .ticker-intro {
      opacity: 0;
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      inView(".ticker", () => {
        (animate as any)(
          ".ticker .ticker-intro",
          { opacity: [0, 1], y: [14, 0] },
          { duration: 0.55, easing: [0.22, 1, 0.36, 1] },
        );
      });
    }
  });
</script>
