---
// MissionSection.astro — mission statement block: left-aligned editorial, navy background.
interface Props {
	heading: string;
	body: string;
}
const { heading, body } = Astro.props;
---

<section class="mission">
	<div class="inner">
		<div class="accent-bar" aria-hidden="true"></div>
		<h2 class="heading">{heading}</h2>
		<p class="body-text">{body}</p>
	</div>
</section>

<style>
	.mission {
		background: var(--color-primary);
		padding: 5rem clamp(1.5rem, 8%, 6rem) 3.5rem;
	}
	.inner {
		max-width: 820px;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.accent-bar {
		width: 2.5rem;
		height: 2px;
		background: var(--color-accent);
		flex-shrink: 0;
	}
	.heading {
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		font-weight: var(--weight-extrabold);
		color: oklch(98% 0.006 220);
		letter-spacing: var(--tracking-tight);
		line-height: 1.08;
		margin: 0;
	}
	.body-text {
		font-size: var(--text-lg);
		color: rgba(255, 255, 255, 0.72);
		line-height: var(--leading-loose);
		margin: 0;
		max-width: 65ch;
	}

	@media (max-width: 900px) {
		.mission {
			padding: 4rem clamp(1.5rem, 6%, 4rem) 5rem;
		}
	}
	@media (max-width: 640px) {
		.mission {
			padding: 3.5rem 1.5rem 4.5rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.accent-bar,
		.heading,
		.body-text {
			opacity: 0;
		}
	}
</style>

<script>
	import { animate, inView } from "motion";

	document.addEventListener("astro:page-load", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		inView(".mission", () => {
			(animate as any)(
				".mission .accent-bar",
				{ opacity: [0, 1] },
				{ duration: 0.4, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".mission .heading",
				{ opacity: [0, 1], y: [24, 0] },
				{ duration: 0.65, delay: 0.1, easing: [0.22, 1, 0.36, 1] },
			);
			(animate as any)(
				".mission .body-text",
				{ opacity: [0, 1], y: [16, 0] },
				{ duration: 0.55, delay: 0.22, easing: [0.22, 1, 0.36, 1] },
			);
		});
	});
</script>
