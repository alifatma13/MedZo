---
// ServicePageCTA.astro — full-width CTA banner matching the home FinalCTA style.
import Button from "../ui/Button.astro";
interface Props {
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}
const { heading, body, ctaLabel, ctaHref } = Astro.props;
---

<section class="svc-cta">
  <div class="gradient-overlay" aria-hidden="true"></div>
  <div class="container">
    <h2 class="cta-heading">{heading}</h2>
    <p class="cta-body">{body}</p>
    <Button label={ctaLabel} href={ctaHref} variant="accent" />
  </div>
</section>

<style>
  .svc-cta {
    background: var(--color-primary);
    padding: 6rem clamp(1.5rem, 8%, 6rem);
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .gradient-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background: radial-gradient(ellipse at center, #fff 0%, transparent 70%);
    pointer-events: none;
  }
  .container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .cta-heading {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--weight-extrabold);
    color: oklch(98% 0.006 220);
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 26ch;
    line-height: 1.1;
  }
  .cta-body {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.72);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 48ch;
  }
  @media (max-width: 768px) {
    .svc-cta { padding: 4rem clamp(1.5rem, 5%, 3rem); }
  }
  @media (max-width: 640px) {
    .svc-cta { padding: 4rem 1.5rem; }
    .container { padding: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-heading,
    .cta-body,
    .btn {
      opacity: 0;
    }
  }
</style>

<script>
  // Scroll-triggered staggered fade-in for the CTA heading, body, and button.
  import { animate, inView } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      inView(".svc-cta", () => {
        (animate as any)(
          ".svc-cta .cta-heading",
          { opacity: [0, 1], y: [24, 0] },
          { duration: 0.6, easing: [0.22, 1, 0.36, 1] },
        );
        (animate as any)(
          ".svc-cta .cta-body",
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: 0.12, easing: [0.22, 1, 0.36, 1] },
        );
        (animate as any)(
          ".svc-cta .btn",
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: 0.25, easing: [0.22, 1, 0.36, 1] },
        );
      });
    }
  });
</script>
