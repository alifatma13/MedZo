---
// ServicePageCTA.astro — gradient CTA strip at the bottom of each service detail page.
interface Props {
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}
const { heading, body, ctaLabel, ctaHref } = Astro.props;
---

<section class="svc-cta">
  <div class="orb" aria-hidden="true"></div>
  <div class="container">
    <h2 class="cta-heading">{heading}</h2>
    <p class="cta-body">{body}</p>
    <a href={ctaHref} class="cta-btn">{ctaLabel}</a>
  </div>
</section>

<style>
  .svc-cta {
    background: var(--color-primary);
    padding: 5.5rem 1.5rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .orb {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    top: -180px;
    right: -100px;
    pointer-events: none;
  }
  .container {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .cta-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: var(--weight-extrabold);
    color: #fff;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0;
  }
  .cta-body {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.82);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 520px;
  }
  .cta-btn {
    display: inline-block;
    margin-top: 0.5rem;
    background: #fff;
    color: var(--color-primary);
    padding: 1rem 2.25rem;
    border-radius: 0.625rem;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.18s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.16);
  }
  .cta-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 8px 36px rgba(0, 0, 0, 0.22);
  }
  .cta-btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .svc-cta { padding: 4rem 1.5rem; }
    .container { max-width: none; }
    .cta-btn { width: 100%; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-btn { transition: none; }
  }
</style>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cta-heading,
    .cta-body,
    .cta-btn {
      opacity: 0;
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      inView(".svc-cta", () => {
        (animate as any)(
          ".svc-cta .cta-heading, .svc-cta .cta-body, .svc-cta .cta-btn",
          { opacity: [0, 1], y: [20, 0] },
          { duration: 0.55, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
        );
      });
    }
  });
</script>
