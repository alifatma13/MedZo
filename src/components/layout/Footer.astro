---
// Footer.astro — site-wide footer with brand blurb, service list, company links, contact info, and legal links.
// Tagline, contact info, acknowledgement, and service links come from Sanity (team-managed).
// Column headings, company links, legal links, and brand strings stay in footer.ts (developer-owned).
import { Image } from "astro:assets";
import logoImg from "../../res/logo.png";
import { footerContent } from "../../lib/content/footer";
import { getSiteSettings } from "../../lib/api/siteSettings";
import { getServices } from "../../lib/api/services";

const [siteSettings, sanityServices] = await Promise.all([
  getSiteSettings(),
  getServices(),
]);

// Services list for the footer column — title + href from Sanity
const footerServices = (sanityServices ?? []).map((s) => ({ label: s.title, href: s.href }));

// Dynamic fields from Sanity with static fallbacks for graceful degradation during local dev
const tagline         = siteSettings?.footerTagline         ?? footerContent.tagline;
const contactEmail    = siteSettings?.contactEmail          ?? footerContent.contact.email;
const contactLocation = siteSettings?.contactLocation       ?? footerContent.contact.location;
const acknowledgement = siteSettings?.acknowledgementText   ?? footerContent.acknowledgement;

// Services column: prefer Sanity list; fall back to static list while content is being entered
const serviceLinks = footerServices.length > 0 ? footerServices : footerContent.services;

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container">
		<div class="brand-col">
			<a href="/" class="footer-logo">
				<Image
					src={logoImg}
					alt={footerContent.logoAlt}
					width={40}
					height={40}
					class="logo-icon"
					format="png"
					quality="max"
					densities={[1, 2]}
				/>
				{footerContent.wordmark}
			</a>
			<p class="tagline">{tagline}</p>
		</div>

		<div class="links-col">
			<p class="col-heading">{footerContent.columnHeadings.services}</p>
			<ul class="link-list">
				{
					serviceLinks.map((s) => (
						<li>
							<a href={s.href} class="footer-link">
								{s.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="links-col">
			<p class="col-heading">{footerContent.columnHeadings.company}</p>
			<ul class="link-list">
				{
					footerContent.company.map((c) => (
						<li>
							<a href={c.href} class="footer-link">
								{c.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="links-col">
			<p class="col-heading">{footerContent.columnHeadings.contact}</p>
			<ul class="link-list">
				<li>
					<a href={`mailto:${contactEmail}`} class="footer-link"
						>{contactEmail}</a
					>
				</li>
				<li>
					<span class="footer-text">{contactLocation}</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="acknowledgement-bar">
		<div class="acknowledgement-inner">
			<p class="acknowledgement-text">{acknowledgement}</p>
		</div>
	</div>

	<div class="bottom-bar">
		<div class="bottom-inner">
			<p class="copyright">&copy; {year} {footerContent.copyright}</p>
			<div class="legal-links">
				{
					footerContent.legalLinks.map((l) => (
						<a href={l.href} class="legal-link">
							{l.label}
						</a>
					))
				}
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-text-heading);
		color: oklch(98% 0.006 220);
		font-family: var(--font-nav);
	}
	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 4rem 2rem;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 3rem;
	}
	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: #fff;
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		margin-bottom: 1rem;
	}
	.logo-icon {
		height: 40px;
		width: auto;
		display: block;
	}
	.tagline {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.75);
		line-height: var(--leading-normal);
		margin: 0;
		max-width: 22rem;
	}
	.col-heading {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: rgba(255, 255, 255, 0.65);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		margin: 0 0 1rem;
		line-height: var(--leading-tight);
	}
	.link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}
	.footer-link {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		transition: color 0.15s;
	}
	.footer-link:hover {
		color: var(--color-accent);
	}
	.footer-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
	}
	.footer-text {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.7);
	}
	.acknowledgement-bar {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	.acknowledgement-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 1.5rem 2rem;
	}
	.acknowledgement-text {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.65);
		line-height: var(--leading-normal);
		margin: 0;
		font-style: italic;
		text-align: center;
	}
	.bottom-bar {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	.bottom-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 1.25rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.copyright {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
	}
	.legal-links {
		display: flex;
		gap: 1.5rem;
	}
	.legal-link {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.65);
		text-decoration: none;
		transition: color 0.15s;
	}
	.legal-link:hover {
		color: rgba(255, 255, 255, 0.9);
	}
	.legal-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
		outline-offset: 2px;
	}
	/* iPad landscape + tablet: 3-col links so CONTACT stays in the same row */
	@media (min-width: 641px) and (max-width: 1024px) {
		.container {
			grid-template-columns: 1fr 1fr 1fr;
			gap: 2rem;
		}
		.brand-col {
			grid-column: span 3;
		}
	}
	@media (max-width: 640px) {
		.container {
			grid-template-columns: 1fr;
		}
		.brand-col {
			grid-column: span 1;
		}
		.bottom-inner {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}
	}
</style>
