---
// Nav.astro — sticky site header with desktop nav links, dropdown for Services, CTA, and mobile drawer.
// Top-level links come from siteSettings.navigation[] in Sanity (team-managed).
// Services dropdown children come from the service collection in Sanity (auto-populates on publish).
// CTA button, brand strings, and the Services parent label stay hardcoded in nav.ts.
import { Image } from "astro:assets";
import logoImg from "../../res/logo.webp";
import { navCta, navBrand, navServicesItem } from "../../lib/content/nav";
import { icons } from "../../lib/utils/icons";
import { getSiteSettings } from "../../lib/api/siteSettings";
import { getServices } from "../../lib/api/services";
import type { NavLink } from "../../types/layout";

const [siteSettings, sanityServices] = await Promise.all([
  getSiteSettings(),
  getServices(),
]);

// Build the services dropdown children from the Sanity service collection
const servicesChildren = (sanityServices ?? []).map((s) => ({
  label:       s.title,
  href:        s.href,
  description: s.navDescription,
  iconName:    s.cardIconName,
}));

// Build the full nav links array:
// 1. Services parent with Sanity-driven dropdown children
// 2. Top-level links from siteSettings.navigation[] where isVisible is not explicitly false
const topLevelLinks = (siteSettings?.navigation ?? []).filter(
  (l) => l.isVisible !== false
);

const navLinks: NavLink[] = [
  { label: navServicesItem.label, href: navServicesItem.href, children: servicesChildren },
  ...topLevelLinks,
];

const pathname = Astro.url.pathname;

/**
 * Returns true when this nav link represents the current route.
 * - "/#services" → active on any /services/* page (parent grouping)
 * - Other hash links → never active (they're section anchors on the home page, not pages)
 * - Everything else → exact or prefix match
 */
function isLinkActive(href: string): boolean {
	if (href === "/#services") return pathname.startsWith("/services");
	if (href.startsWith("/#")) return false;
	if (href === "/") return pathname === "/";
	return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="nav-header">
	<nav class="nav-inner" aria-label="Primary">
		<a href="/" class="nav-logo">
			<Image
				src={logoImg}
				alt={navBrand.logoAlt}
				class="logo-icon"
				width={44}
				height={44}
				format="png"
				quality="max"
				densities={[1, 2]}
				loading="eager"
			/>
			<span class="logo-text">
				<span class="wordmark">{navBrand.wordmark}</span>
				<span class="tagline">{navBrand.tagline}</span>
			</span>
		</a>
		<ul class="nav-links">
			{navLinks.map((link) =>
				link.children ? (
					<li class="nav-item has-dropdown">
						<a
							href={link.href}
							class:list={["nav-link nav-link--parent", { "is-active": isLinkActive(link.href) }]}
							aria-current={isLinkActive(link.href) ? "page" : undefined}
						>
							{link.label}
						</a>
						<button
							class="dropdown-toggle"
							aria-expanded="false"
							aria-haspopup="true"
							aria-label={`Toggle ${link.label} submenu`}
						>
							<span class="dropdown-chevron" aria-hidden="true">
								<Fragment set:html={icons["chevron-down"]} />
							</span>
						</button>
						<div class="dropdown" aria-label={`${link.label} submenu`}>
							<div class="dropdown-inner">
								{link.children.map((child) => (
									<a
										href={child.href}
										class:list={["dropdown-item", { "is-active": isLinkActive(child.href) }]}
										aria-current={isLinkActive(child.href) ? "page" : undefined}
									>
										<span class="dropdown-icon" aria-hidden="true">
											<Fragment set:html={icons[child.iconName] ?? ""} />
										</span>
										<span class="dropdown-text">
											<span class="dropdown-label">{child.label}</span>
											{child.description && <span class="dropdown-desc">{child.description}</span>}
										</span>
									</a>
								))}
							</div>
						</div>
					</li>
				) : (
					<li class="nav-item">
						<a
							href={link.href}
							class:list={["nav-link", { "is-active": isLinkActive(link.href) }]}
							aria-current={isLinkActive(link.href) ? "page" : undefined}
						>
							{link.label}
						</a>
					</li>
				)
			)}
		</ul>
		<a href={navCta.href} class="nav-cta">{navCta.label}</a>
		<button
			class="hamburger"
			id="hamburger-btn"
			aria-label={navBrand.ariaOpenMenu}
			aria-expanded="false"
			aria-controls="mobile-drawer"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
	</nav>
</header>

<!-- Backdrop -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<!-- Left-side mobile drawer -->
<aside
	class="mobile-drawer"
	id="mobile-drawer"
	role="dialog"
	aria-modal="true"
	aria-label={navBrand.ariaDialog}
	aria-hidden="true"
>
	<div class="drawer-top">
		<a href="/" class="drawer-logo">
			<Image
				src={logoImg}
				alt={navBrand.logoAlt}
				width={36}
				height={36}
				format="png"
				quality="max"
			/>
			<span class="drawer-wordmark">{navBrand.wordmark}</span>
		</a>
		<button
			class="close-btn"
			id="drawer-close-btn"
			aria-label={navBrand.ariaCloseMenu}
		>
			<Fragment set:html={icons["nav-close"]} />
		</button>
	</div>

	<nav class="drawer-nav" aria-label="Mobile navigation">
		<ul class="drawer-links">
			{navLinks.map((link) =>
				link.children ? (
					<li class="drawer-item drawer-item--parent">
						<button
							class:list={["drawer-link drawer-toggle", { "is-active": isLinkActive(link.href) }]}
							aria-expanded="false"
						>
							{link.label}
							<span class="drawer-chevron" aria-hidden="true">
								<Fragment set:html={icons["chevron-down"]} />
							</span>
						</button>
						<ul class="drawer-sub" aria-hidden="true">
							{link.children.map((child) => (
								<li>
									<a
										href={child.href}
										class:list={["drawer-link drawer-sub-link", { "is-active": isLinkActive(child.href) }]}
										aria-current={isLinkActive(child.href) ? "page" : undefined}
									>
										<span class="drawer-sub-icon" aria-hidden="true">
											<Fragment set:html={icons[child.iconName] ?? ""} />
										</span>
										{child.label}
									</a>
								</li>
							))}
						</ul>
					</li>
				) : (
					<li>
						<a
							href={link.href}
							class:list={["drawer-link", { "is-active": isLinkActive(link.href) }]}
							aria-current={isLinkActive(link.href) ? "page" : undefined}
						>
							{link.label}
						</a>
					</li>
				)
			)}
		</ul>
	</nav>

	<div class="drawer-footer">
		<a href={navCta.href} class="drawer-cta">{navCta.label}</a>
		<p class="drawer-tagline">{navBrand.drawerTagline}</p>
	</div>
</aside>

<style>
	/* ── Desktop nav ─────────────────────────────────────── */
	.nav-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--nav-bg, var(--color-bg-hero));
		box-shadow: none;
		padding-top: 0.75rem;
		transition: box-shadow 0.25s ease;
	}
	.nav-header.scrolled {
		box-shadow: 0 1px 12px rgba(0, 0, 0, 0.08);
	}
	.nav-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2rem;
		height: 64px;
		display: flex;
		align-items: center;
		gap: 2rem;
		font-family: var(--font-nav);
	}
	.nav-logo {
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		text-decoration: none;
		margin-right: auto;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		letter-spacing: 0.02em;
	}
	.logo-text {
		display: flex;
		flex-direction: column;
		gap: 0;
		line-height: 1;
	}
	.wordmark {
		font-family: var(--font-wordmark);
		font-size: 2.1rem;
		font-weight: var(--weight-regular);
		letter-spacing: 0.02em;
		color: var(--color-primary);
	}
	.tagline {
		font-family: var(--font-wordmark);
		font-size: 0.65rem;
		font-weight: var(--weight-regular);
		color: var(--color-primary);
		letter-spacing: 0.08em;
	}
	.logo-icon {
		height: 44px;
		width: auto;
		display: block;
	}
	.nav-links {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 2rem;
	}
	.nav-item {
		position: relative;
	}
	.nav-link {
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
		text-decoration: none;
		position: relative;
		transition: color 0.15s;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 44px;
		padding-inline: 0.25rem;
	}
	.nav-link::after {
		content: "";
		position: absolute;
		bottom: -3px;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.nav-item.has-dropdown {
		display: flex;
		align-items: center;
	}
	.dropdown-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25rem 0.5rem;
		min-width: 44px;
		min-height: 44px;
		color: var(--color-text-heading);
		border-radius: 2px;
		flex-shrink: 0;
		transition: color 0.15s;
	}
	.dropdown-toggle:hover {
		color: var(--color-primary);
	}
	.dropdown-toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
	}
	.nav-link:hover {
		color: var(--color-primary);
	}
	.nav-link:hover::after {
		transform: scaleX(1);
	}
	.nav-link.is-active {
		color: var(--color-primary);
	}
	.nav-link.is-active::after {
		transform: scaleX(1);
		background: var(--color-primary);
	}
	.nav-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
	}
	.dropdown-chevron {
		display: flex;
		align-items: center;
		width: 16px;
		height: 16px;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
		flex-shrink: 0;
	}
	.dropdown-chevron svg {
		width: 14px;
		height: 14px;
	}

	/* ── Dropdown panel ──────────────────────────────────── */
	.dropdown {
		position: absolute;
		top: calc(100% + 1.25rem);
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		width: 580px;
		background: oklch(99.5% 0.004 220);
		border: 1px solid rgba(0, 50, 125, 0.1);
		border-radius: 1rem;
		box-shadow:
			0 20px 60px rgba(0, 50, 125, 0.14),
			0 4px 16px rgba(0, 0, 0, 0.06);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0.2s;
		z-index: 200;
	}
	.dropdown::before {
		content: "";
		position: absolute;
		top: -6px;
		left: 50%;
		transform: translateX(-50%) rotate(45deg);
		width: 12px;
		height: 12px;
		background: oklch(99.5% 0.004 220);
		border-top: 1px solid rgba(0, 50, 125, 0.1);
		border-left: 1px solid rgba(0, 50, 125, 0.1);
	}
	.has-dropdown.is-open .dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%) translateY(0);
		transition:
			opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0s;
	}
	.has-dropdown.is-open .dropdown-chevron {
		transform: rotate(180deg);
	}
	.dropdown-inner {
		padding: 0.75rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.25rem;
	}
	.dropdown-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.75rem;
		border-radius: 0.5rem;
		text-decoration: none;
		transition: background 0.15s;
	}
	.dropdown-item:hover {
		background: var(--color-bg-hero);
	}
	.dropdown-item.is-active {
		background: var(--color-bg-hero);
	}
	.dropdown-item.is-active .dropdown-label {
		color: var(--color-primary);
		font-weight: var(--weight-medium);
	}
	.dropdown-item:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 0.625rem;
	}
	.dropdown-icon {
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: var(--color-primary);
		padding: 4px;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
		margin-top: 2px;
	}
	.dropdown-icon svg {
		width: 100%;
		height: 100%;
	}
	.dropdown-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.dropdown-label {
		font-size: 0.8rem;
		font-weight: var(--weight-semibold);
		color: var(--color-text-heading);
		line-height: 1.3;
		transition: color 0.15s;
	}
	.dropdown-item:hover .dropdown-label {
		color: var(--color-primary);
	}
	.dropdown-desc {
		font-size: 0.7rem;
		font-weight: var(--weight-regular);
		color: oklch(50% 0.025 240);
		line-height: 1.4;
	}
	.nav-cta {
		background: var(--color-primary);
		color: oklch(98% 0.006 220);
		padding: 0.5rem 1.25rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		transition: transform 0.15s, filter 0.15s;
	}
	.nav-cta:hover {
		transform: scale(1.04);
		filter: brightness(1.15);
	}
	.nav-cta:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	/* ── Hamburger button ────────────────────────────────── */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		border-radius: 0.375rem;
		flex-shrink: 0;
	}
	.hamburger:focus-visible {
		outline: 2px solid var(--color-accent);
	}
	.bar {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--color-text-heading);
		border-radius: 999px;
		transition:
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.2s;
		transform-origin: center;
	}
	.hamburger.is-open .bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.hamburger.is-open .bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}
	.hamburger.is-open .bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ── Backdrop ────────────────────────────────────────── */
	.drawer-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(11, 28, 48, 0.45);
		backdrop-filter: blur(3px);
		z-index: 200;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}
	.drawer-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	/* ── Mobile drawer ───────────────────────────────────── */
	.mobile-drawer {
		position: fixed;
		top: 0;
		left: 0;
		height: 100%;
		width: 300px;
		max-width: 88vw;
		background: var(--color-bg-hero);
		border-right: 1px solid rgba(0, 50, 125, 0.08);
		box-shadow: 4px 0 32px rgba(0, 50, 125, 0.12);
		z-index: 300;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		gap: 0;
		font-family: var(--font-nav);
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0.35s;
	}
	.mobile-drawer.is-open {
		transform: translateX(0);
		visibility: visible;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0s;
	}

	/* Drawer top: logo + close */
	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(0, 50, 125, 0.08);
		margin-bottom: 1.5rem;
	}
	.drawer-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.drawer-wordmark {
		font-family: var(--font-wordmark);
		font-size: 1.6rem;
		color: var(--color-primary);
		font-weight: var(--weight-regular);
	}
	.close-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: 1px solid rgba(0, 50, 125, 0.12);
		border-radius: 0.375rem;
		cursor: pointer;
		color: var(--color-text-heading);
		transition:
			background 0.15s,
			border-color 0.15s;
		flex-shrink: 0;
	}
	.close-btn:hover {
		background: rgba(0, 50, 125, 0.06);
		border-color: rgba(0, 50, 125, 0.2);
	}
	.close-btn:focus-visible {
		outline: 2px solid var(--color-accent);
	}

	/* Drawer nav links */
	.drawer-nav {
		flex: 1;
		overflow-y: auto;
		scrollbar-width: none;
	}
	.drawer-nav::-webkit-scrollbar {
		display: none;
	}
	.drawer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.drawer-link {
		display: flex;
		align-items: center;
		width: 100%;
		padding: 0.875rem 0.75rem;
		font-size: 1.05rem;
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
		text-decoration: none;
		border-radius: 0.5rem;
		transition:
			color 0.15s,
			background 0.15s;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		font-family: var(--font-nav);
	}
	.drawer-link:hover {
		color: var(--color-primary);
		background: rgba(0, 50, 125, 0.05);
	}
	.drawer-link.is-active {
		color: var(--color-primary);
		background: rgba(0, 50, 125, 0.07);
		font-weight: var(--weight-semibold);
	}
	.drawer-link:focus-visible {
		outline: 2px solid var(--color-accent);
	}
	.drawer-toggle {
		justify-content: space-between;
	}
	.drawer-chevron {
		display: flex;
		align-items: center;
		width: 18px;
		height: 18px;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
		flex-shrink: 0;
	}
	.drawer-chevron svg {
		width: 16px;
		height: 16px;
	}
	.drawer-toggle[aria-expanded="true"] .drawer-chevron {
		transform: rotate(180deg);
	}
	.drawer-sub {
		list-style: none;
		margin: 0;
		padding: 0 0 0 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.drawer-sub[aria-hidden="false"] {
		max-height: 500px;
	}
	.drawer-sub-link {
		font-size: var(--text-sm);
		padding: 0.625rem 0.75rem;
		gap: 0.625rem;
		align-items: center;
	}
	.drawer-sub-icon {
		display: flex;
		align-items: center;
		width: 22px;
		height: 22px;
		padding: 4px;
		color: var(--color-primary);
		flex-shrink: 0;
		margin-top: 1px;
	}
	.drawer-sub-icon svg {
		width: 100%;
		height: 100%;
	}

	/* Drawer footer: CTA + tagline */
	.drawer-footer {
		padding-top: 1.5rem;
		border-top: 1px solid rgba(0, 50, 125, 0.08);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
	}
	.drawer-cta {
		display: block;
		text-align: center;
		background: var(--color-primary);
		color: oklch(98% 0.006 220);
		padding: 0.875rem 1.5rem;
		border-radius: 0.5rem;
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		transition: transform 0.15s, filter 0.15s;
	}
	.drawer-cta:hover {
		transform: scale(1.02);
		filter: brightness(1.15);
	}
	.drawer-cta:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.drawer-tagline {
		font-size: var(--text-sm);
		color: rgba(0, 50, 125, 0.4);
		text-align: center;
		margin: 0;
		letter-spacing: 0.04em;
	}

	/* ── Responsive ──────────────────────────────────────── */
	@media (max-width: 1024px) {
		.nav-links {
			display: none;
		}
		.nav-cta {
			display: none;
		}
		.hamburger {
			display: flex;
		}
	}
	@media (max-width: 480px) {
		.nav-inner {
			padding: 0 1rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@keyframes dropdown-item-in {
			from { opacity: 0; transform: translateY(5px); }
			to   { opacity: 1; transform: translateY(0); }
		}
		.has-dropdown.is-open .dropdown-item {
			animation: dropdown-item-in 0.22s cubic-bezier(0.22, 1, 0.36, 1) both;
		}
		.has-dropdown.is-open .dropdown-item:nth-child(1) { animation-delay: 0ms; }
		.has-dropdown.is-open .dropdown-item:nth-child(2) { animation-delay: 45ms; }
		.has-dropdown.is-open .dropdown-item:nth-child(3) { animation-delay: 90ms; }
		.has-dropdown.is-open .dropdown-item:nth-child(4) { animation-delay: 135ms; }
		.has-dropdown.is-open .dropdown-item:nth-child(5) { animation-delay: 180ms; }
		.has-dropdown.is-open .dropdown-item:nth-child(6) { animation-delay: 225ms; }
		.dropdown-item:hover .dropdown-icon {
			transform: scale(1.1);
		}
		.dropdown-item:hover .dropdown-text {
			transform: translateX(2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-drawer,
		.drawer-backdrop,
		.bar,
		.dropdown,
		.dropdown-chevron,
		.drawer-chevron,
		.drawer-sub {
			transition: none;
		}
	}
</style>

<script>
	let _scrollHandler: (() => void) | null = null;
	let _keydownHandler: ((e: KeyboardEvent) => void) | null = null;

	document.addEventListener("astro:page-load", () => {
		const header = document.querySelector(".nav-header");
		const hamburger = document.getElementById("hamburger-btn");
		const backdrop = document.getElementById("drawer-backdrop");
		const drawer = document.getElementById("mobile-drawer");
		const closeBtn = document.getElementById("drawer-close-btn");
		const drawerLinks = drawer?.querySelectorAll(".drawer-link:not(.drawer-toggle), .drawer-cta");

		// Adds .scrolled to header after 10px scroll for shadow/background change
		if (_scrollHandler) window.removeEventListener("scroll", _scrollHandler);
		_scrollHandler = () => {
			header?.classList.toggle("scrolled", window.scrollY > 10);
		};
		window.addEventListener("scroll", _scrollHandler, { passive: true });

		// ── Mobile drawer ────────────────────────────────────
		// Opens drawer, locks scroll, moves focus to first link
		function openDrawer() {
			drawer?.classList.add("is-open");
			backdrop?.classList.add("is-open");
			drawer?.removeAttribute("aria-hidden");
			hamburger?.setAttribute("aria-expanded", "true");
			hamburger?.classList.add("is-open");
			document.body.style.overflow = "hidden";
			setTimeout(() => {
				(drawer?.querySelector(".drawer-link") as HTMLElement | null)?.focus();
			}, 50);
		}

		// Closes drawer, restores scroll, returns focus to hamburger
		function closeDrawer() {
			drawer?.classList.remove("is-open");
			backdrop?.classList.remove("is-open");
			drawer?.setAttribute("aria-hidden", "true");
			hamburger?.setAttribute("aria-expanded", "false");
			hamburger?.classList.remove("is-open");
			document.body.style.overflow = "";
			hamburger?.focus();
		}

		hamburger?.addEventListener("click", () => {
			drawer?.classList.contains("is-open") ? closeDrawer() : openDrawer();
		});
		closeBtn?.addEventListener("click", closeDrawer);
		backdrop?.addEventListener("click", closeDrawer);
		drawerLinks?.forEach((link) => link.addEventListener("click", closeDrawer));

		// ── Mobile accordion toggles ─────────────────────────
		const toggles = drawer?.querySelectorAll<HTMLButtonElement>(".drawer-toggle");
		toggles?.forEach((btn) => {
			btn.addEventListener("click", () => {
				const expanded = btn.getAttribute("aria-expanded") === "true";
				const sub = btn.nextElementSibling as HTMLElement | null;
				btn.setAttribute("aria-expanded", String(!expanded));
				if (sub) sub.setAttribute("aria-hidden", String(expanded));
			});
		});

		// ── Desktop dropdown hover + keyboard toggle ─────────
		const dropdownItems = document.querySelectorAll<HTMLElement>(".has-dropdown");
		dropdownItems.forEach((item) => {
			let hideTimer: ReturnType<typeof setTimeout> | null = null;
			const toggleBtn = item.querySelector<HTMLButtonElement>(".dropdown-toggle");

			// Shows dropdown panel; clears any pending hide timer
			function openDropdown() {
				if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
				item.classList.add("is-open");
				toggleBtn?.setAttribute("aria-expanded", "true");
			}
			// Hides dropdown panel and resets aria-expanded
			function closeDropdown() {
				item.classList.remove("is-open");
				toggleBtn?.setAttribute("aria-expanded", "false");
			}

			item.addEventListener("mouseenter", openDropdown);
			item.addEventListener("mouseleave", () => {
				hideTimer = setTimeout(() => { closeDropdown(); hideTimer = null; }, 150);
			});

			// Click / Enter / Space on the toggle button
			toggleBtn?.addEventListener("click", (e) => {
				e.stopPropagation();
				item.classList.contains("is-open") ? closeDropdown() : openDropdown();
			});
		});

		// ── Keyboard: Escape closes drawer/dropdown; Tab is trapped inside open drawer ──
		if (_keydownHandler) document.removeEventListener("keydown", _keydownHandler);
		_keydownHandler = (e: KeyboardEvent) => {
			if (e.key === "Escape") {
				if (drawer?.classList.contains("is-open")) {
					closeDrawer();
					return;
				}
				const activeParent = document.querySelector<HTMLElement>(".has-dropdown.is-open");
				if (activeParent) {
					activeParent.classList.remove("is-open");
					const btn = activeParent.querySelector<HTMLElement>(".dropdown-toggle");
					btn?.setAttribute("aria-expanded", "false");
					btn?.focus();
				}
				return;
			}
			if (!drawer?.classList.contains("is-open")) return;
			if (e.key !== "Tab") return;
			const focusable = Array.from(
				drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
			);
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey) {
				if (document.activeElement === first) { e.preventDefault(); last.focus(); }
			} else {
				if (document.activeElement === last) { e.preventDefault(); first.focus(); }
			}
		};
		document.addEventListener("keydown", _keydownHandler);
	});
</script>
