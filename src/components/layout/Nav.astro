---
// Nav.astro — sticky site header with desktop nav links, dropdown for Services, CTA, and mobile drawer.
import { Image } from "astro:assets";
import logoImg from "../../res/logo.png";
import { navLinks, navCta, navBrand } from "../../lib/content/nav";
import { icons } from "../../lib/utils/icons";
---

<header class="nav-header">
	<nav class="nav-inner" aria-label="Primary">
		<a href="/" class="nav-logo">
			<Image
				src={logoImg}
				alt={navBrand.logoAlt}
				class="logo-icon"
				width={44}
				height={44}
				format="png"
				quality="max"
				densities={[1, 2]}
				loading="eager"
			/>
			<span class="logo-text">
				<span class="wordmark">{navBrand.wordmark}</span>
				<span class="tagline">{navBrand.tagline}</span>
			</span>
		</a>
		<ul class="nav-links">
			{navLinks.map((link) =>
				link.children ? (
					<li class="nav-item has-dropdown">
						<a
							href={link.href}
							class="nav-link nav-link--parent"
							aria-haspopup="true"
							aria-expanded="false"
						>
							{link.label}
							<span class="dropdown-chevron" aria-hidden="true">
								<Fragment set:html={icons["chevron-down"]} />
							</span>
						</a>
						<div class="dropdown" role="menu" aria-label={`${link.label} submenu`}>
							<div class="dropdown-inner">
								{link.children.map((child) => (
									<a href={child.href} class="dropdown-item" role="menuitem">
										<span class="dropdown-icon" aria-hidden="true">
											<Fragment set:html={icons[child.iconName] ?? ""} />
										</span>
										<span class="dropdown-content">
											<span class="dropdown-label">{child.label}</span>
											<span class="dropdown-desc">{child.description}</span>
										</span>
									</a>
								))}
							</div>
						</div>
					</li>
				) : (
					<li class="nav-item">
						<a href={link.href} class="nav-link">
							{link.label}
						</a>
					</li>
				)
			)}
		</ul>
		<a href={navCta.href} class="nav-cta">{navCta.label}</a>
		<button
			class="hamburger"
			id="hamburger-btn"
			aria-label={navBrand.ariaOpenMenu}
			aria-expanded="false"
			aria-controls="mobile-drawer"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
	</nav>
</header>

<!-- Backdrop -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<!-- Left-side mobile drawer -->
<aside
	class="mobile-drawer"
	id="mobile-drawer"
	role="dialog"
	aria-modal="true"
	aria-label={navBrand.ariaDialog}
	aria-hidden="true"
>
	<div class="drawer-top">
		<a href="/" class="drawer-logo">
			<Image
				src={logoImg}
				alt={navBrand.logoAlt}
				width={36}
				height={36}
				format="png"
				quality="max"
			/>
			<span class="drawer-wordmark">{navBrand.wordmark}</span>
		</a>
		<button
			class="close-btn"
			id="drawer-close-btn"
			aria-label={navBrand.ariaCloseMenu}
		>
			<Fragment set:html={icons["nav-close"]} />
		</button>
	</div>

	<nav class="drawer-nav" aria-label="Mobile navigation">
		<ul class="drawer-links">
			{navLinks.map((link) =>
				link.children ? (
					<li class="drawer-item drawer-item--parent">
						<button
							class="drawer-link drawer-toggle"
							aria-expanded="false"
						>
							{link.label}
							<span class="drawer-chevron" aria-hidden="true">
								<Fragment set:html={icons["chevron-down"]} />
							</span>
						</button>
						<ul class="drawer-sub" aria-hidden="true">
							{link.children.map((child) => (
								<li>
									<a href={child.href} class="drawer-link drawer-sub-link">
										<span class="drawer-sub-icon" aria-hidden="true">
											<Fragment set:html={icons[child.iconName] ?? ""} />
										</span>
										{child.label}
									</a>
								</li>
							))}
						</ul>
					</li>
				) : (
					<li>
						<a href={link.href} class="drawer-link">
							{link.label}
						</a>
					</li>
				)
			)}
		</ul>
	</nav>

	<div class="drawer-footer">
		<a href={navCta.href} class="drawer-cta">{navCta.label}</a>
		<p class="drawer-tagline">{navBrand.drawerTagline}</p>
	</div>
</aside>

<style>
	/* ── Desktop nav ─────────────────────────────────────── */
	.nav-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-bg-hero);
		box-shadow: none;
		padding-top: 0.75rem;
		transition: box-shadow 0.25s ease;
	}
	.nav-header.scrolled {
		box-shadow: 0 1px 12px rgba(0, 0, 0, 0.08);
	}
	.nav-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2rem;
		height: 64px;
		display: flex;
		align-items: center;
		gap: 2rem;
		font-family: var(--font-nav);
	}
	.nav-logo {
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		text-decoration: none;
		margin-right: auto;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		letter-spacing: 0.02em;
	}
	.logo-text {
		display: flex;
		flex-direction: column;
		gap: 0;
		line-height: 1;
	}
	.wordmark {
		font-family: var(--font-wordmark);
		font-size: 2.1rem;
		font-weight: var(--weight-regular);
		letter-spacing: 0.02em;
		color: var(--color-primary);
	}
	.tagline {
		font-family: var(--font-wordmark);
		font-size: 0.65rem;
		font-weight: var(--weight-regular);
		color: var(--color-primary);
		letter-spacing: 0.08em;
	}
	.logo-icon {
		height: 44px;
		width: auto;
		display: block;
	}
	.nav-links {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 2rem;
	}
	.nav-item {
		position: relative;
	}
	.nav-link {
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
		text-decoration: none;
		position: relative;
		transition: color 0.15s;
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.nav-link::after {
		content: "";
		position: absolute;
		bottom: -3px;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.nav-link--parent::after {
		width: calc(100% - 1.25rem);
	}
	.nav-link:hover {
		color: var(--color-primary);
	}
	.nav-link:hover::after {
		transform: scaleX(1);
	}
	.nav-link:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 2px;
	}
	.dropdown-chevron {
		display: flex;
		align-items: center;
		width: 16px;
		height: 16px;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
		flex-shrink: 0;
	}
	.dropdown-chevron svg {
		width: 14px;
		height: 14px;
	}

	/* ── Dropdown panel ──────────────────────────────────── */
	.dropdown {
		position: absolute;
		top: calc(100% + 1.25rem);
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		width: 320px;
		background: #fff;
		border: 1px solid rgba(0, 50, 125, 0.1);
		border-radius: 1rem;
		box-shadow:
			0 20px 60px rgba(0, 50, 125, 0.14),
			0 4px 16px rgba(0, 0, 0, 0.06);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0.2s;
		z-index: 200;
	}
	.dropdown::before {
		content: "";
		position: absolute;
		top: -6px;
		left: 50%;
		transform: translateX(-50%) rotate(45deg);
		width: 12px;
		height: 12px;
		background: #fff;
		border-top: 1px solid rgba(0, 50, 125, 0.1);
		border-left: 1px solid rgba(0, 50, 125, 0.1);
	}
	.has-dropdown.is-open .dropdown,
	.has-dropdown:focus-within .dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%) translateY(0);
		transition:
			opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0s;
	}
	.has-dropdown.is-open .dropdown-chevron,
	.has-dropdown:focus-within .dropdown-chevron {
		transform: rotate(180deg);
	}
	.dropdown-inner {
		padding: 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.dropdown-item {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		padding: 0.75rem 0.875rem;
		border-radius: 0.625rem;
		text-decoration: none;
		transition: background 0.15s;
	}
	.dropdown-item:hover {
		background: var(--color-bg-hero);
	}
	.dropdown-item:focus-visible {
		outline: 2px solid var(--color-accent);
		border-radius: 0.625rem;
	}
	.dropdown-icon {
		width: 36px;
		height: 36px;
		border-radius: 0.5rem;
		background: var(--gradient-brand);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: #fff;
		padding: 8px;
	}
	.dropdown-icon svg {
		width: 100%;
		height: 100%;
	}
	.dropdown-content {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.dropdown-label {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-heading);
		line-height: 1.3;
	}
	.dropdown-desc {
		font-size: var(--text-xs);
		color: var(--color-text-body);
		line-height: var(--leading-snug);
	}
	.nav-cta {
		background: var(--gradient-cta);
		color: #fff;
		padding: 0.5rem 1.25rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		transition: transform 0.15s;
	}
	.nav-cta:hover {
		transform: scale(1.04);
	}
	.nav-cta:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	/* ── Hamburger button ────────────────────────────────── */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		border-radius: 0.375rem;
		flex-shrink: 0;
	}
	.hamburger:focus-visible {
		outline: 2px solid var(--color-accent);
	}
	.bar {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--color-text-heading);
		border-radius: 999px;
		transition:
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.2s;
		transform-origin: center;
	}
	.hamburger.is-open .bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.hamburger.is-open .bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}
	.hamburger.is-open .bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ── Backdrop ────────────────────────────────────────── */
	.drawer-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(11, 28, 48, 0.45);
		backdrop-filter: blur(3px);
		z-index: 200;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}
	.drawer-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	/* ── Mobile drawer ───────────────────────────────────── */
	.mobile-drawer {
		position: fixed;
		top: 0;
		left: 0;
		height: 100%;
		width: 300px;
		max-width: 88vw;
		background: var(--color-bg-hero);
		border-right: 1px solid rgba(0, 50, 125, 0.08);
		box-shadow: 4px 0 32px rgba(0, 50, 125, 0.12);
		z-index: 300;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		gap: 0;
		font-family: var(--font-nav);
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0.35s;
	}
	.mobile-drawer.is-open {
		transform: translateX(0);
		visibility: visible;
		transition:
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s 0s;
	}

	/* Drawer top: logo + close */
	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(0, 50, 125, 0.08);
		margin-bottom: 1.5rem;
	}
	.drawer-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.drawer-wordmark {
		font-family: var(--font-wordmark);
		font-size: 1.6rem;
		color: var(--color-primary);
		font-weight: var(--weight-regular);
	}
	.close-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: 1px solid rgba(0, 50, 125, 0.12);
		border-radius: 0.375rem;
		cursor: pointer;
		color: var(--color-text-heading);
		transition:
			background 0.15s,
			border-color 0.15s;
		flex-shrink: 0;
	}
	.close-btn:hover {
		background: rgba(0, 50, 125, 0.06);
		border-color: rgba(0, 50, 125, 0.2);
	}
	.close-btn:focus-visible {
		outline: 2px solid var(--color-accent);
	}

	/* Drawer nav links */
	.drawer-nav {
		flex: 1;
		overflow-y: auto;
	}
	.drawer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.drawer-link {
		display: flex;
		align-items: center;
		width: 100%;
		padding: 0.875rem 0.75rem;
		font-size: 1.05rem;
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
		text-decoration: none;
		border-radius: 0.5rem;
		transition:
			color 0.15s,
			background 0.15s;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		font-family: var(--font-nav);
	}
	.drawer-link:hover {
		color: var(--color-primary);
		background: rgba(0, 50, 125, 0.05);
	}
	.drawer-link:focus-visible {
		outline: 2px solid var(--color-accent);
	}
	.drawer-toggle {
		justify-content: space-between;
	}
	.drawer-chevron {
		display: flex;
		align-items: center;
		width: 18px;
		height: 18px;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
		flex-shrink: 0;
	}
	.drawer-chevron svg {
		width: 16px;
		height: 16px;
	}
	.drawer-toggle[aria-expanded="true"] .drawer-chevron {
		transform: rotate(180deg);
	}
	.drawer-sub {
		list-style: none;
		margin: 0;
		padding: 0 0 0 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.drawer-sub[aria-hidden="false"] {
		max-height: 300px;
	}
	.drawer-sub-link {
		font-size: var(--text-sm);
		padding: 0.625rem 0.75rem;
		gap: 0.625rem;
	}
	.drawer-sub-icon {
		display: flex;
		align-items: center;
		width: 22px;
		height: 22px;
		border-radius: 0.3rem;
		background: var(--gradient-brand);
		padding: 4px;
		color: #fff;
		flex-shrink: 0;
	}
	.drawer-sub-icon svg {
		width: 100%;
		height: 100%;
	}

	/* Drawer footer: CTA + tagline */
	.drawer-footer {
		padding-top: 1.5rem;
		border-top: 1px solid rgba(0, 50, 125, 0.08);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
	}
	.drawer-cta {
		display: block;
		text-align: center;
		background: var(--gradient-cta);
		color: #fff;
		padding: 0.875rem 1.5rem;
		border-radius: 0.5rem;
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		transition: transform 0.15s;
	}
	.drawer-cta:hover {
		transform: scale(1.02);
	}
	.drawer-cta:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.drawer-tagline {
		font-size: var(--text-sm);
		color: rgba(0, 50, 125, 0.4);
		text-align: center;
		margin: 0;
		letter-spacing: 0.04em;
	}

	/* ── Responsive ──────────────────────────────────────── */
	@media (max-width: 1024px) {
		.nav-links {
			display: none;
		}
		.nav-cta {
			display: none;
		}
		.hamburger {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-drawer,
		.drawer-backdrop,
		.bar,
		.dropdown,
		.dropdown-chevron,
		.drawer-chevron,
		.drawer-sub {
			transition: none;
		}
	}
</style>

<script>
	let _scrollHandler: (() => void) | null = null;
	let _keydownHandler: ((e: KeyboardEvent) => void) | null = null;

	document.addEventListener("astro:page-load", () => {
		const header = document.querySelector(".nav-header");
		const hamburger = document.getElementById("hamburger-btn");
		const backdrop = document.getElementById("drawer-backdrop");
		const drawer = document.getElementById("mobile-drawer");
		const closeBtn = document.getElementById("drawer-close-btn");
		const drawerLinks = drawer?.querySelectorAll(".drawer-link:not(.drawer-toggle), .drawer-cta");

		if (_scrollHandler) window.removeEventListener("scroll", _scrollHandler);
		_scrollHandler = () => {
			header?.classList.toggle("scrolled", window.scrollY > 10);
		};
		window.addEventListener("scroll", _scrollHandler, { passive: true });

		// ── Mobile drawer ────────────────────────────────────
		function openDrawer() {
			drawer?.classList.add("is-open");
			backdrop?.classList.add("is-open");
			drawer?.removeAttribute("aria-hidden");
			hamburger?.setAttribute("aria-expanded", "true");
			hamburger?.classList.add("is-open");
			document.body.style.overflow = "hidden";
			setTimeout(() => {
				(drawer?.querySelector(".drawer-link") as HTMLElement | null)?.focus();
			}, 50);
		}

		function closeDrawer() {
			drawer?.classList.remove("is-open");
			backdrop?.classList.remove("is-open");
			drawer?.setAttribute("aria-hidden", "true");
			hamburger?.setAttribute("aria-expanded", "false");
			hamburger?.classList.remove("is-open");
			document.body.style.overflow = "";
			hamburger?.focus();
		}

		hamburger?.addEventListener("click", () => {
			drawer?.classList.contains("is-open") ? closeDrawer() : openDrawer();
		});
		closeBtn?.addEventListener("click", closeDrawer);
		backdrop?.addEventListener("click", closeDrawer);
		drawerLinks?.forEach((link) => link.addEventListener("click", closeDrawer));

		// ── Mobile accordion toggles ─────────────────────────
		const toggles = drawer?.querySelectorAll<HTMLButtonElement>(".drawer-toggle");
		toggles?.forEach((btn) => {
			btn.addEventListener("click", () => {
				const expanded = btn.getAttribute("aria-expanded") === "true";
				const sub = btn.nextElementSibling as HTMLElement | null;
				btn.setAttribute("aria-expanded", String(!expanded));
				if (sub) sub.setAttribute("aria-hidden", String(expanded));
			});
		});

		// ── Desktop dropdown hover ──────────────────────────
		const dropdownItems = document.querySelectorAll<HTMLElement>(".has-dropdown");
		dropdownItems.forEach((item) => {
			let hideTimer: ReturnType<typeof setTimeout> | null = null;
			const trigger = item.querySelector<HTMLElement>("[aria-expanded]");
			item.addEventListener("mouseenter", () => {
				if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
				item.classList.add("is-open");
				trigger?.setAttribute("aria-expanded", "true");
			});
			item.addEventListener("mouseleave", () => {
				hideTimer = setTimeout(() => {
					item.classList.remove("is-open");
					trigger?.setAttribute("aria-expanded", "false");
					hideTimer = null;
				}, 150);
			});
		});

		// ── Keyboard: close dropdown on Escape ───────────────
		if (_keydownHandler) document.removeEventListener("keydown", _keydownHandler);
		_keydownHandler = (e: KeyboardEvent) => {
			if (e.key === "Escape") {
				if (drawer?.classList.contains("is-open")) {
					closeDrawer();
					return;
				}
				const activeParent = document.querySelector<HTMLElement>(".has-dropdown:focus-within");
				if (activeParent) {
					const link = activeParent.querySelector<HTMLElement>(".nav-link");
					link?.blur();
					link?.focus();
				}
				return;
			}
			if (!drawer?.classList.contains("is-open")) return;
			if (e.key !== "Tab") return;
			const focusable = Array.from(
				drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
			);
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey) {
				if (document.activeElement === first) { e.preventDefault(); last.focus(); }
			} else {
				if (document.activeElement === last) { e.preventDefault(); first.focus(); }
			}
		};
		document.addEventListener("keydown", _keydownHandler);
	});
</script>
